# ──────────────────────────────────────────────
# Campus Peer Support API — Environment Variables
# ──────────────────────────────────────────────
# Copy this file to .env and fill in your values
# ──────────────────────────────────────────────

# App
NODE_ENV=development
PORT=3001
API_PREFIX=/api

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campus_peer_support?schema=public"

# Auth — JWT Secrets (generate strong random strings, min 32 chars)
JWT_SECRET="your-super-secret-jwt-secret-change-in-production-min-32-chars"
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET="your-super-secret-refresh-secret-change-in-production-min-32-chars"
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# University Email Domain
UNIVERSITY_EMAIL_DOMAIN=cuchd.in

# Email (Resend) — Required for OTP registration flow
# Get your API key at https://resend.com
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxx"
EMAIL_FROM="noreply@cuchd.in"

# Frontend
FRONTEND_URL=http://localhost:4321

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
