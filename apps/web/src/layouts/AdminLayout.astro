---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  adminName?: string;
  currentPage?: string;
}

const {
  title = 'Admin Dashboard | Peerly',
  description = 'Administrative dashboard for managing the peer support platform.',
  adminName = 'Admin',
  currentPage = 'dashboard',
} = Astro.props;

const navItems = [
  { href: '/admin/dashboard', label: 'Dashboard', icon: 'chart-bar' },
  { href: '/admin/mentors', label: 'Mentors', icon: 'briefcase' },
  { href: '/admin/students', label: 'Students', icon: 'graduation-cap' },
  { href: '/admin/meetings', label: 'Meetings', icon: 'calendar' },
  { href: '/admin/workshops', label: 'Workshops', icon: 'wrench' },
  { href: '/admin/resources', label: 'Resources', icon: 'book-open' },
];

const NAV_ICONS: Record<string, string> = {
  'chart-bar':
    '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>',
  briefcase:
    '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg>',
  'graduation-cap':
    '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>',
  calendar:
    '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>',
  wrench:
    '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg>',
  'book-open':
    '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg>',
};
---

<BaseLayout
  title={title}
  description={description}
  currentRole="ADMIN"
  displayName={adminName}
  isFullWidth={true}
>
  <div class="text-gray-1000 flex min-h-[calc(100vh-4rem)]">
    <!-- Desktop Sidebar -->
    <aside
      class="bg-background-100 hidden border-r border-gray-200 lg:fixed lg:left-0 lg:top-16 lg:z-20 lg:flex lg:h-[calc(100vh-4rem)] lg:w-64 lg:flex-col"
    >
      <div class="flex h-full flex-col">
        <!-- Sidebar Header -->
        <div class="flex h-16 items-center justify-between border-b border-gray-200 px-6">
          <div class="flex items-center gap-2.5">
            <span class="text-heading-16 text-gray-1000 font-bold">Admin Portal</span>
          </div>
        </div>

        <!-- Navigation -->
        <nav class="flex-1 space-y-1.5 overflow-y-auto px-4 py-6" aria-label="Admin navigation">
          {
            navItems.map(item => (
              <a
                href={item.href}
                class={`flex items-center gap-3 rounded-md px-4 py-2.5 text-sm font-medium transition-all duration-150 ${
                  currentPage === item.href.split('/').pop()
                    ? 'active-sidebar-link shadow-sm'
                    : 'text-slate-300 hover:bg-gray-800 hover:text-white'
                }`}
                aria-current={currentPage === item.href.split('/').pop() ? 'page' : undefined}
              >
                <span
                  class="flex h-5 w-5 flex-shrink-0 items-center justify-center"
                  set:html={NAV_ICONS[item.icon]}
                />
                <span>{item.label}</span>
              </a>
            ))
          }
        </nav>

        <!-- Sidebar Footer -->
        <div class="border-t border-slate-200 p-4">
          <p class="text-center text-xs text-slate-500">Peerly</p>
        </div>
      </div>
    </aside>

    <!-- Mobile sidebar backdrop -->
    <div
      class="fixed inset-0 z-40 hidden bg-black/50 lg:hidden"
      id="sidebar-backdrop"
      aria-hidden="true"
    >
    </div>

    <!-- Main Content Content Wrapper -->
    <main class="flex min-h-[calc(100vh-4rem)] flex-1 flex-col lg:pl-64">
      <!-- Mobile header (non-sticky to avoid overlap with main navbar) -->
      <header
        class="flex h-16 items-center justify-between border-b border-slate-200 bg-white px-4 lg:hidden"
      >
        <button
          class="rounded-lg p-2 text-slate-600 hover:bg-slate-100"
          onclick="document.getElementById('mobile-sidebar').classList.remove('-translate-x-full'); document.getElementById('sidebar-backdrop').classList.remove('hidden')"
          aria-label="Open navigation menu"
          aria-expanded="false"
          aria-controls="mobile-sidebar"
        >
          <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
        <h1 class="text-heading-16 font-semibold text-slate-900">Admin Portal</h1>
        <div class="w-10"></div>
      </header>

      <!-- Mobile sidebar -->
      <aside
        id="mobile-sidebar"
        class="fixed inset-y-0 left-0 z-50 w-64 -translate-x-full transform border-r border-slate-200 bg-white transition-transform duration-300 ease-in-out lg:hidden"
        aria-label="Mobile navigation"
      >
        <div class="flex h-full flex-col">
          <div class="flex h-16 items-center justify-between border-b border-gray-200 px-4">
            <div class="flex items-center gap-2">
              <span class="text-heading-16 text-gray-1000 font-bold">Admin Portal</span>
            </div>
            <button
              class="rounded-sm p-2 text-gray-700 hover:bg-gray-100"
              onclick="document.getElementById('mobile-sidebar').classList.add('-translate-x-full'); document.getElementById('sidebar-backdrop').classList.add('hidden')"
              aria-label="Close navigation menu"
            >
              <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M6 18L18 6M6 6l12 12"></path>
              </svg>
            </button>
          </div>

          <nav class="flex-1 space-y-1 overflow-y-auto p-4" aria-label="Admin navigation">
            {
              navItems.map(item => (
                <a
                  href={item.href}
                  class={`flex items-center gap-3 rounded-sm px-3 py-2 text-sm font-semibold transition-colors ${
                    currentPage === item.href.split('/').pop()
                      ? 'active-sidebar-link'
                      : 'text-slate-300 hover:bg-gray-800 hover:text-white'
                  }`}
                  aria-current={currentPage === item.href.split('/').pop() ? 'page' : undefined}
                  onclick="document.getElementById('mobile-sidebar').classList.add('-translate-x-full'); document.getElementById('sidebar-backdrop').classList.add('hidden')"
                >
                  <span class="flex-shrink-0" set:html={NAV_ICONS[item.icon]} />
                  <span>{item.label}</span>
                </a>
              ))
            }
          </nav>

          <div class="border-t border-slate-200 p-4">
            <p class="text-center text-xs text-slate-500">Peerly</p>
          </div>
        </div>
      </aside>

      <!-- Page Content -->
      <div class="flex-1 p-6 lg:p-8">
        <slot />
      </div>
    </main>
  </div>

  <script>
    // Close mobile sidebar when clicking backdrop
    document.getElementById('sidebar-backdrop')?.addEventListener('click', () => {
      document.getElementById('mobile-sidebar')?.classList.add('-translate-x-full');
      document.getElementById('sidebar-backdrop')?.classList.add('hidden');
    });

    // Close mobile sidebar on escape key
    document.addEventListener('keydown', e => {
      if (e.key === 'Escape') {
        document.getElementById('mobile-sidebar')?.classList.add('-translate-x-full');
        document.getElementById('sidebar-backdrop')?.classList.add('hidden');
      }
    });
  </script>
</BaseLayout>
