---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title?: string;
  description?: string;
  mentorName?: string;
  isVerified?: boolean;
}

const {
  title = 'Mentor Dashboard | Peer Support',
  description = 'Mentor hub for managing active chats, hosting workshops, and supporting students.',
  mentorName = '',
  isVerified = true,
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  currentRole="MENTOR"
  displayName={mentorName}
  isVerified={isVerified}
>
  <div class="space-y-6">
    <div class="flex items-center justify-between border-b border-gray-200 pb-4">
      <div>
        <h1 class="text-heading-24 text-gray-1000 font-bold">Mentor Portal</h1>
        {mentorName && (
          <p class="text-label-12 mt-1 text-gray-600">
            Welcome, <span
              class="rounded border border-gray-200 bg-gray-100 px-2 py-0.5 font-medium text-gray-800"
              >{mentorName}</span
            >
          </p>
        )}
      </div>
    </div>
    <slot />
  </div>
</BaseLayout>
