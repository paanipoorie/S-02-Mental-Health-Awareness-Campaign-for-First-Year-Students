---

<section class="relative z-10 mx-auto w-full max-w-5xl border-t border-gray-200/50 px-6 py-32">
  <div class="mb-20 max-w-xl text-left">
    <h2 class="text-heading-32 sm:text-heading-40 text-gray-1000 font-bold tracking-tight">
      Core workspace features.
    </h2>
  </div>

  <div class="grid grid-cols-1 gap-x-12 gap-y-16 md:grid-cols-2 lg:grid-cols-3">
    <!-- Feature 1: Anonymous Discussions -->
    <div class="flex flex-col">
      <h3 class="text-heading-16 text-gray-1000 mb-2 font-bold">Forums & Discussions</h3>
      <p class="text-label-13 leading-relaxed text-gray-600">
        Post questions, share experiences, and receive support from peers in forums using your
        anonymous persona.
      </p>
    </div>

    <!-- Feature 2: Peer Chat -->
    <div class="flex flex-col">
      <h3 class="text-heading-16 text-gray-1000 mb-2 font-bold">1-on-1 Peer Chat</h3>
      <p class="text-label-13 leading-relaxed text-gray-600">
        Message securely and privately with your assigned upper-class mentor inside the platform.
      </p>
    </div>

    <!-- Feature 3: Events -->
    <div class="flex flex-col">
      <h3 class="text-heading-16 text-gray-1000 mb-2 font-bold">Group Events</h3>
      <p class="text-label-13 leading-relaxed text-gray-600">
        Sign up and participate in peer-led support groups, online workshops, and stress relief
        sessions.
      </p>
    </div>

    <!-- Feature 4: Mentor Support -->
    <div class="flex flex-col">
      <h3 class="text-heading-16 text-gray-1000 mb-2 font-bold">Verified Mentors</h3>
      <p class="text-label-13 leading-relaxed text-gray-600">
        Receive guidance from upper-level students who are verified by university administration and
        trained in support.
      </p>
    </div>

    <!-- Feature 5: Resources -->
    <div class="flex flex-col">
      <h3 class="text-heading-16 text-gray-1000 mb-2 font-bold">University Resources</h3>
      <p class="text-label-13 leading-relaxed text-gray-600">
        Access links to campus clinics, wellness materials, and professional emergency crisis
        services.
      </p>
    </div>

    <!-- Feature 6: Dashboard Analytics (Admin/Mentor) -->
    <div class="flex flex-col">
      <h3 class="text-heading-16 text-gray-1000 mb-2 font-bold">Operational Controls</h3>
      <p class="text-label-13 leading-relaxed text-gray-600">
        Oversee system usage, verify peer mentors, manage crisis resources, and review reported
        content from the admin dashboard.
      </p>
    </div>
  </div>
</section>
