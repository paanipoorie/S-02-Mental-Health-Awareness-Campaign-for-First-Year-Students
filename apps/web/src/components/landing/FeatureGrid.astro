---
---
<section class="py-20 border-t border-gray-200/50 relative z-10 px-6 max-w-7xl mx-auto w-full">
  <div class="text-center mb-16">
    <h2 class="text-xs font-bold uppercase tracking-wider text-tertiary mb-3">Platform Features</h2>
    <h3 class="text-heading-32 sm:text-heading-40 font-bold text-gray-1000 tracking-tight max-w-2xl mx-auto">
      Fully-featured environment for peer support.
    </h3>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    <!-- Feature 1: Anonymous Discussions -->
    <div class="p-6 rounded-sm border border-gray-200 bg-background-200 hover:border-gray-300 transition-colors flex flex-col justify-between h-[230px]">
      <div>
        <div class="w-8 h-8 rounded-sm bg-gray-100 flex items-center justify-center mb-4 text-gray-800">
          <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M8.625 9.75a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H8.25m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0H12m4.125 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm0 0h-.375m-13.5 3.01c0 1.6 1.123 2.994 2.707 3.227 1.087.16 2.185.283 3.293.369V21l4.184-4.183a1.14 1.14 0 01.778-.332 48.294 48.294 0 005.83-.498c1.585-.233 2.708-1.626 2.708-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
          </svg>
        </div>
        <h4 class="text-heading-16 font-bold text-gray-1000 mb-2">Anonymous Discussions</h4>
        <p class="text-label-13 text-gray-600 leading-relaxed">
          Open forums where students post questions, share experiences, and receive support, identified only by their anonymous avatars.
        </p>
      </div>
    </div>

    <!-- Feature 2: Peer Chat -->
    <div class="p-6 rounded-sm border border-gray-200 bg-background-200 hover:border-gray-300 transition-colors flex flex-col justify-between h-[230px]">
      <div>
        <div class="w-8 h-8 rounded-sm bg-gray-100 flex items-center justify-center mb-4 text-gray-800">
          <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379L12 21l3.12-3.136c1.152-.086 2.293-.213 3.423-.379 1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
          </svg>
        </div>
        <h4 class="text-heading-16 font-bold text-gray-1000 mb-2">1-on-1 Peer Chat</h4>
        <p class="text-label-13 text-gray-600 leading-relaxed">
          Instant messaging with your assigned mentor. All messages are encrypted, secure, and private between you and your mentor.
        </p>
      </div>
    </div>

    <!-- Feature 3: Events -->
    <div class="p-6 rounded-sm border border-gray-200 bg-background-200 hover:border-gray-300 transition-colors flex flex-col justify-between h-[230px]">
      <div>
        <div class="w-8 h-8 rounded-sm bg-gray-100 flex items-center justify-center mb-4 text-gray-800">
          <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5m-9-6h.008v.008H12v-.008zM12 15h.008v.008H12V15zm0 2.25h.008v.008H12v-.008zM9.75 15h.008v.008H9.75V15zm0 2.25h.008v.008H9.75v-.008zM7.5 15h.008v.008H7.5V15zm0 2.25h.008v.008H7.5v-.008zM14.25 15h.008v.008H14.25V15zm0 2.25h.008v.008H14.25v-.008zM16.5 15h.008v.008H16.5V15zm0 2.25h.008v.008H16.5v-.008z" />
          </svg>
        </div>
        <h4 class="text-heading-16 font-bold text-gray-1000 mb-2">Group Events</h4>
        <p class="text-label-13 text-gray-600 leading-relaxed">
          Sign up and participate in peer-led support groups, online workshops, and stress relief events directly inside the browser.
        </p>
      </div>
    </div>

    <!-- Feature 4: Mentor Support -->
    <div class="p-6 rounded-sm border border-gray-200 bg-background-200 hover:border-gray-300 transition-colors flex flex-col justify-between h-[230px]">
      <div>
        <div class="w-8 h-8 rounded-sm bg-gray-100 flex items-center justify-center mb-4 text-gray-800">
          <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.005 9.005 0 00-3.1-6.18M18 18.72c0-1.28-.75-2.45-1.92-2.92a9.001 9.001 0 00-6.16 0M18 18.72h1.5m-12.75 0H3m14.25-9.33a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0zM3 18.72a9.005 9.005 0 013.1-6.18M3 18.72c0-1.28.75-2.45 1.92-2.92a9 9 0 016.16 0M3 18.72h1.5m3.75-9.33a3.375 3.375 0 11-6.75 0 3.375 3.375 0 016.75 0z" />
          </svg>
        </div>
        <h4 class="text-heading-16 font-bold text-gray-1000 mb-2">Verified Peer Mentors</h4>
        <p class="text-label-13 text-gray-600 leading-relaxed">
          Trained upper-level students verified by university administration to guide first-year students and handle escalations safely.
        </p>
      </div>
    </div>

    <!-- Feature 5: Resources -->
    <div class="p-6 rounded-sm border border-gray-200 bg-background-200 hover:border-gray-300 transition-colors flex flex-col justify-between h-[230px]">
      <div>
        <div class="w-8 h-8 rounded-sm bg-gray-100 flex items-center justify-center mb-4 text-gray-800">
          <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-.778.099-1.533.284-2.253" />
          </svg>
        </div>
        <h4 class="text-heading-16 font-bold text-gray-1000 mb-2">Campus Resources</h4>
        <p class="text-label-13 text-gray-600 leading-relaxed">
          Quick access to university health centers, professional counselors, and active emergency crisis numbers when required.
        </p>
      </div>
    </div>

    <!-- Feature 6: Dashboard Analytics (Admin/Mentor) -->
    <div class="p-6 rounded-sm border border-gray-200 bg-background-200 hover:border-gray-300 transition-colors flex flex-col justify-between h-[230px]">
      <div>
        <div class="w-8 h-8 rounded-sm bg-gray-100 flex items-center justify-center mb-4 text-gray-800">
          <svg class="h-4.5 w-4.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z" />
            <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z" />
          </svg>
        </div>
        <h4 class="text-heading-16 font-bold text-gray-1000 mb-2">Administrative Dashboard</h4>
        <p class="text-label-13 text-gray-600 leading-relaxed">
          Administrators can review platform stats, verify mentors, manage resources, and oversee reports anonymously and responsibly.
        </p>
      </div>
    </div>
  </div>
</section>
