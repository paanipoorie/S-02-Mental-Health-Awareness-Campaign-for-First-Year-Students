---
<section class="py-32 border-t border-gray-200/50 relative z-10 px-6 max-w-5xl mx-auto w-full">
  <div class="mb-20 text-left max-w-xl">
    <h2 class="text-heading-32 sm:text-heading-40 font-bold text-gray-1000 tracking-tight">
      Core workspace features.
    </h2>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-16">
    <!-- Feature 1: Anonymous Discussions -->
    <div class="flex flex-col">
      <h3 class="text-heading-16 font-bold text-gray-1000 mb-2">Forums & Discussions</h3>
      <p class="text-label-13 text-gray-600 leading-relaxed">
        Post questions, share experiences, and receive support from peers in forums using your anonymous persona.
      </p>
    </div>

    <!-- Feature 2: Peer Chat -->
    <div class="flex flex-col">
      <h3 class="text-heading-16 font-bold text-gray-1000 mb-2">1-on-1 Peer Chat</h3>
      <p class="text-label-13 text-gray-600 leading-relaxed">
        Message securely and privately with your assigned upper-class mentor inside the platform.
      </p>
    </div>

    <!-- Feature 3: Events -->
    <div class="flex flex-col">
      <h3 class="text-heading-16 font-bold text-gray-1000 mb-2">Group Events</h3>
      <p class="text-label-13 text-gray-600 leading-relaxed">
        Sign up and participate in peer-led support groups, online workshops, and stress relief sessions.
      </p>
    </div>

    <!-- Feature 4: Mentor Support -->
    <div class="flex flex-col">
      <h3 class="text-heading-16 font-bold text-gray-1000 mb-2">Verified Mentors</h3>
      <p class="text-label-13 text-gray-600 leading-relaxed">
        Receive guidance from upper-level students who are verified by university administration and trained in support.
      </p>
    </div>

    <!-- Feature 5: Resources -->
    <div class="flex flex-col">
      <h3 class="text-heading-16 font-bold text-gray-1000 mb-2">University Resources</h3>
      <p class="text-label-13 text-gray-600 leading-relaxed">
        Access links to campus clinics, wellness materials, and professional emergency crisis services.
      </p>
    </div>

    <!-- Feature 6: Dashboard Analytics (Admin/Mentor) -->
    <div class="flex flex-col">
      <h3 class="text-heading-16 font-bold text-gray-1000 mb-2">Operational Controls</h3>
      <p class="text-label-13 text-gray-600 leading-relaxed">
        Oversee system usage, verify peer mentors, manage crisis resources, and review reported content from the admin dashboard.
      </p>
    </div>
  </div>
</section>
