---

---

<section
  class="relative z-10 flex min-h-[85vh] select-none flex-col items-center justify-center px-6 text-center"
>
  <!-- Heading -->
  <h1
    class="text-heading-40 sm:text-heading-56 md:text-heading-64 text-gray-1000 mb-6 max-w-3xl font-bold leading-[1.05] tracking-tight"
  >
    Peer support, verified by your university.
  </h1>

  <!-- Supporting paragraph -->
  <p class="text-copy-16 sm:text-copy-18 mb-10 max-w-xl leading-relaxed text-gray-600">
    Discuss academic pressure, stress, and isolation with upper-class mentors. Your credentials
    verify student status, but your identity remains anonymous to everyone.
  </p>

  <!-- CTA Buttons -->
  <div
    id="hero-loading-placeholder"
    class="flex w-full max-w-md items-center justify-center gap-4"
  >
    <div class="h-10 w-32 animate-pulse rounded-sm bg-gray-200"></div>
    <div class="h-10 w-24 animate-pulse rounded-sm bg-gray-200"></div>
  </div>

  <div id="hero-guest-ctas" class="hidden w-full max-w-md flex-col items-center justify-center gap-4 sm:flex-row">
    <a
      href="/register"
      class="bg-primary text-background-100 text-button-14 w-full cursor-pointer rounded-sm px-6 py-3 text-center font-semibold transition-colors hover:bg-gray-800 sm:w-auto"
    >
      Create Account
    </a>
    <a
      href="/login"
      class="text-button-14 w-full cursor-pointer rounded-sm border border-gray-200 px-6 py-3 text-center font-semibold text-gray-700 transition-colors hover:bg-gray-50 sm:w-auto"
    >
      Sign In
    </a>
  </div>

  <div id="hero-member-ctas" class="hidden w-full max-w-md flex-col items-center justify-center gap-4 sm:flex-row">
    <a
      id="hero-dashboard-btn"
      href="/dashboard"
      class="bg-primary text-background-100 text-button-14 w-full cursor-pointer rounded-sm px-6 py-3 text-center font-semibold transition-colors hover:bg-gray-800 sm:w-auto"
    >
      Go to Dashboard
    </a>
  </div>

  <script is:inline>
    // Sub-second pre-initialization check to prevent layout shift
    (function () {
      const rawUser = localStorage.getItem('caps_user_profile');
      const hasToken = !!localStorage.getItem('caps_access_token');
      let role = null;
      if (hasToken && rawUser) {
        try {
          role = JSON.parse(rawUser).role;
        } catch (e) {}
      }
      if (role) {
        document.getElementById('hero-loading-placeholder')?.classList.add('hidden');
        document.getElementById('hero-loading-placeholder')?.classList.remove('flex');
        
        const dashboardBtn = document.getElementById('hero-dashboard-btn');
        if (dashboardBtn) {
          if (role === 'MENTOR') {
            dashboardBtn.href = '/mentor/dashboard';
          } else if (role === 'ADMIN') {
            dashboardBtn.href = '/admin/dashboard';
          } else {
            dashboardBtn.href = '/dashboard';
          }
        }
        document.getElementById('hero-member-ctas')?.classList.remove('hidden');
        document.getElementById('hero-member-ctas')?.classList.add('flex');
      } else {
        document.getElementById('hero-loading-placeholder')?.classList.add('hidden');
        document.getElementById('hero-loading-placeholder')?.classList.remove('flex');
        document.getElementById('hero-guest-ctas')?.classList.remove('hidden');
        document.getElementById('hero-guest-ctas')?.classList.add('flex');
      }
    })();
  </script>

  <script>
    import { $user, $isLoading } from '../../stores/authStore';

    const guestCtas = document.getElementById('hero-guest-ctas');
    const memberCtas = document.getElementById('hero-member-ctas');
    const loadingPlaceholder = document.getElementById('hero-loading-placeholder');
    const dashboardBtn = document.getElementById('hero-dashboard-btn') as HTMLAnchorElement;

    function updateHero(user: any, loading: boolean) {
      if (loading) {
        loadingPlaceholder?.classList.remove('hidden');
        loadingPlaceholder?.classList.add('flex');
        guestCtas?.classList.add('hidden');
        guestCtas?.classList.remove('flex');
        memberCtas?.classList.add('hidden');
        memberCtas?.classList.remove('flex');
        return;
      }

      loadingPlaceholder?.classList.add('hidden');
      loadingPlaceholder?.classList.remove('flex');

      if (user) {
        if (dashboardBtn) {
          if (user.role === 'MENTOR') {
            dashboardBtn.href = '/mentor/dashboard';
          } else if (user.role === 'ADMIN') {
            dashboardBtn.href = '/admin/dashboard';
          } else {
            dashboardBtn.href = '/dashboard';
          }
        }
        guestCtas?.classList.add('hidden');
        guestCtas?.classList.remove('flex');
        memberCtas?.classList.remove('hidden');
        memberCtas?.classList.add('flex');
      } else {
        memberCtas?.classList.add('hidden');
        memberCtas?.classList.remove('flex');
        guestCtas?.classList.remove('hidden');
        guestCtas?.classList.add('flex');
      }
    }

    $user.subscribe(user => {
      updateHero(user, $isLoading.get());
    });

    $isLoading.subscribe(loading => {
      updateHero($user.get(), loading);
    });
  </script>
</section>
