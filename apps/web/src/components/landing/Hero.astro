---
---
<section class="min-h-[85vh] flex flex-col justify-center items-center text-center px-6 relative z-10 select-none">
  <!-- Badge -->
  <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-orange-500/10 border border-orange-500/20 mb-6 animate-fade-in">
    <span class="w-1.5 h-1.5 rounded-full bg-tertiary"></span>
    <span class="text-[11px] sm:text-xs font-semibold text-tertiary tracking-wide uppercase">CONFIDENTIAL & SAFE SPACE</span>
  </div>

  <!-- Heading -->
  <h1 class="text-heading-40 sm:text-heading-56 md:text-heading-64 font-bold text-gray-1000 tracking-tight max-w-4xl leading-[1.1] mb-6">
    Anonymous peer support <br class="hidden sm:inline" />
    built for first-year students.
  </h1>

  <!-- Supporting text -->
  <p class="text-copy-16 sm:text-copy-18 text-gray-600 max-w-2xl leading-relaxed mb-10">
    Connect with verified peer mentors, join anonymous group discussions, and access mental health resources. Share freely without fear of exposure.
  </p>

  <!-- CTA Buttons -->
  <div class="flex flex-col sm:flex-row items-center justify-center gap-4 w-full max-w-md mb-8">
    <a
      href="/register"
      class="w-full sm:w-auto px-6 py-3 bg-primary text-background-100 hover:bg-gray-800 rounded-sm text-button-14 font-bold transition-all shadow-lg hover:shadow-orange-500/5 text-center cursor-pointer"
    >
      Create Anonymous Account
    </a>
    <a
      href="/login"
      class="w-full sm:w-auto px-6 py-3 border border-gray-200 text-gray-700 hover:bg-gray-50 rounded-sm text-button-14 font-semibold transition-all text-center cursor-pointer"
    >
      Sign In to Portal
    </a>
  </div>

  <!-- Trust message -->
  <div class="flex items-center gap-2 text-xs font-semibold text-gray-500">
    <svg class="h-4 w-4 text-emerald-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
    </svg>
    <span>Verification secure. Your real identity is never saved.</span>
  </div>
</section>
