---

---

<footer class="relative z-10 mt-32 w-full select-none border-t border-gray-200/50 px-6 py-24">
  <div class="mx-auto max-w-5xl">
    <div class="mb-16 grid grid-cols-1 gap-12 md:grid-cols-12">
      <!-- Brand column -->
      <div class="md:col-span-6">
        <div class="mb-4 flex items-center gap-2">
          <svg
            class="text-gray-1000 h-5 w-5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.109A11.386 11.386 0 0110.089 18M15 12a3.75 3.75 0 100-7.5 3.75 3.75 0 000 7.5zm-6 9c.172 0 .343-.003.514-.01M9 21a9.041 9.041 0 01-6.208-3.07 3.562 3.562 0 013.47-4.43H9m12 0H9m12 0v-1.5m0 1.5v1.5M9 12a3.75 3.75 0 100-7.5 3.75 3.75 0 000 7.5z"
            ></path>
          </svg>
          <span class="text-heading-16 text-gray-1000 font-bold tracking-tight">Peerly</span>
        </div>
        <p class="text-label-13 max-w-sm leading-relaxed text-gray-600">
          A peer support network for students. Discuss pressure, stress, and isolation with verified
          mentors.
        </p>
      </div>

      <!-- Links Column 1: Workspace -->
      <div class="md:col-span-2 md:col-start-7">
        <h4 class="mb-4 text-xs font-semibold uppercase tracking-wider text-gray-400">Workspace</h4>
        <ul class="space-y-3 text-xs font-semibold text-gray-600">
          <li><a href="/login" class="hover:text-gray-1000 transition-colors">Sign In</a></li>
          <li><a href="/register" class="hover:text-gray-1000 transition-colors">Register</a></li>
          <li><a href="/dashboard" class="hover:text-gray-1000 transition-colors">Dashboard</a></li>
        </ul>
      </div>

      <!-- Links Column 2: Legal -->
      <div class="md:col-span-2">
        <h4 class="mb-4 text-xs font-semibold uppercase tracking-wider text-gray-400">Legal</h4>
        <ul class="space-y-3 text-xs font-semibold text-gray-600">
          <li>
            <a href="/privacy" class="hover:text-gray-1000 transition-colors">Privacy Policy</a>
          </li>
          <li>
            <a href="/terms" class="hover:text-gray-1000 transition-colors">Terms of Service</a>
          </li>
          <li><a href="/safety" class="hover:text-gray-1000 transition-colors">Safety Guide</a></li>
        </ul>
      </div>

      <!-- Links Column 3: Resources -->
      <div class="md:col-span-2">
        <h4 class="mb-4 text-xs font-semibold uppercase tracking-wider text-gray-400">Resources</h4>
        <ul class="space-y-3 text-xs font-semibold text-gray-600">
          <li><a href="/resources" class="hover:text-gray-1000 transition-colors">Centers</a></li>
          <li><a href="/safety" class="hover:text-gray-1000 transition-colors">Hotlines</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom metadata -->
    <div
      class="flex flex-col items-center justify-between gap-4 border-t border-gray-200/30 pt-8 sm:flex-row"
    >
      <p class="text-[11px] font-medium text-gray-400">
        &copy; 2026 Peerly. Strictly anonymous student portal.
      </p>
      <div class="flex items-center gap-1.5 text-[11px] font-semibold text-gray-500">
        <span class="h-1.5 w-1.5 rounded-full bg-emerald-500"></span>
        <span>Secure cryptographic hashing. Zero persistent activity logs.</span>
      </div>
    </div>
  </div>
</footer>
