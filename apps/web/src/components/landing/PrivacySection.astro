<section class="relative z-10 mx-auto w-full max-w-5xl border-t border-gray-200/50 px-6 py-32">
  <div class="grid grid-cols-1 items-start gap-16 md:grid-cols-12">
    <!-- Left Column -->
    <div class="md:col-span-5">
      <h2 class="text-heading-32 sm:text-heading-40 text-gray-1000 mb-6 font-bold tracking-tight">
        Verified privacy.
      </h2>
      <p class="text-copy-15 leading-relaxed text-gray-600">
        Verify your active student status securely. The platform processes credentials to confirm
        enrollment, but separates verification from your persona and activities entirely.
      </p>
    </div>

    <!-- Right Column (No boxes, pure typographic list) -->
    <div class="space-y-10 md:col-span-7">
      <div>
        <h3 class="text-heading-16 text-gray-1000 mb-1.5 font-bold">Verification Hashing</h3>
        <p class="text-label-13 leading-relaxed text-gray-600">
          Student email addresses are checked for eligibility, hashed for rate-limiting, and
          immediately discarded. Raw email data is never saved or linked to posts.
        </p>
      </div>

      <div>
        <h3 class="text-heading-16 text-gray-1000 mb-1.5 font-bold">Zero Identity Logs</h3>
        <p class="text-label-13 leading-relaxed text-gray-600">
          No names, student numbers, IP logs, or browser metadata are saved in our database. Your
          activity is completely disassociated from your real identity.
        </p>
      </div>

      <div>
        <h3 class="text-heading-16 text-gray-1000 mb-1.5 font-bold">Encrypted Conversations</h3>
        <p class="text-label-13 leading-relaxed text-gray-600">
          All messaging history, discussions, and event bookings are encrypted. Access is protected
          by session tokens, keeping student history secure.
        </p>
      </div>
    </div>
  </div>
</section>
