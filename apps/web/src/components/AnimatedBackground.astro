---

---

<div
  class="pointer-events-none fixed inset-0 z-0 select-none overflow-hidden"
  aria-hidden="true"
  id="global-motion-bg"
>
  <!-- Shape 1: Circle -->
  <svg
    class="absolute h-44 w-44 opacity-0 transition-opacity duration-1000 sm:h-60 sm:w-60"
    id="global-shape-circle"
    viewBox="0 0 100 100"
  >
    <circle
      cx="50"
      cy="50"
      r="45"
      fill="none"
      stroke="rgba(148, 163, 184, 0.065)"
      stroke-width="0.8"></circle>
  </svg>
  <!-- Shape 2: Square -->
  <svg
    class="absolute h-48 w-48 opacity-0 transition-opacity duration-1000 sm:h-64 sm:w-64"
    id="global-shape-square"
    viewBox="0 0 100 100"
  >
    <rect
      x="5"
      y="5"
      width="90"
      height="90"
      fill="none"
      stroke="rgba(201, 106, 43, 0.075)"
      stroke-width="0.8"></rect>
  </svg>
  <!-- Shape 3: Triangle -->
  <svg
    class="absolute h-44 w-44 opacity-0 transition-opacity duration-1000 sm:h-60 sm:w-60"
    id="global-shape-triangle"
    viewBox="0 0 100 100"
  >
    <polygon
      points="50,10 90,85 10,85"
      fill="none"
      stroke="rgba(148, 163, 184, 0.065)"
      stroke-width="0.8"></polygon>
  </svg>
  <!-- Shape 4: Hexagon -->
  <svg
    class="absolute h-48 w-48 opacity-0 transition-opacity duration-1000 sm:h-64 sm:w-64"
    id="global-shape-hexagon"
    viewBox="0 0 100 100"
  >
    <polygon
      points="50,6 88,28 88,72 50,94 12,72 12,28"
      fill="none"
      stroke="rgba(201, 106, 43, 0.075)"
      stroke-width="0.8"></polygon>
  </svg>
  <!-- Connecting lines SVG -->
  <svg
    class="absolute inset-0 h-full w-full opacity-0 transition-opacity duration-1000"
    id="global-shapes-connections"
  >
    <line
      id="g-line-1"
      x1="0"
      y1="0"
      x2="0"
      y2="0"
      stroke="rgba(148, 163, 184, 0.03)"
      stroke-width="0.5"
      stroke-dasharray="4 4"></line>
    <line
      id="g-line-2"
      x1="0"
      y1="0"
      x2="0"
      y2="0"
      stroke="rgba(148, 163, 184, 0.03)"
      stroke-width="0.5"
      stroke-dasharray="4 4"></line>
    <line
      id="g-line-3"
      x1="0"
      y1="0"
      x2="0"
      y2="0"
      stroke="rgba(148, 163, 184, 0.03)"
      stroke-width="0.5"
      stroke-dasharray="4 4"></line>
    <line
      id="g-line-4"
      x1="0"
      y1="0"
      x2="0"
      y2="0"
      stroke="rgba(148, 163, 184, 0.03)"
      stroke-width="0.5"
      stroke-dasharray="4 4"></line>
  </svg>
</div>

<script>
  (function () {
    const bgContainer = document.getElementById('global-motion-bg');
    if (!bgContainer) return;

    const shapes = [
      {
        id: 'global-shape-circle',
        vw: 0.1,
        vh: 0.2,
        speedX: 0.00002,
        speedY: 0.000015,
        speedR: 0.00001,
        pulseSpeed: 0.0002,
        pulseOffset: 0,
        ampX: 120,
        ampY: 90,
        ampR: 2.0,
        parallax: 0.25,
        size: 190,
      },
      {
        id: 'global-shape-square',
        vw: 0.88,
        vh: 0.15,
        speedX: 0.000015,
        speedY: 0.00002,
        speedR: 0.000015,
        pulseSpeed: 0.00015,
        pulseOffset: 1.5,
        ampX: 100,
        ampY: 110,
        ampR: 3.0,
        parallax: 0.45,
        size: 220,
      },
      {
        id: 'global-shape-triangle',
        vw: 0.08,
        vh: 0.78,
        speedX: 0.00002,
        speedY: 0.00002,
        speedR: 0.000018,
        pulseSpeed: 0.00025,
        pulseOffset: 3.0,
        ampX: 110,
        ampY: 100,
        ampR: 2.5,
        parallax: 0.35,
        size: 190,
      },
      {
        id: 'global-shape-hexagon',
        vw: 0.85,
        vh: 0.72,
        speedX: 0.000012,
        speedY: 0.000018,
        speedR: 0.000012,
        pulseSpeed: 0.00018,
        pulseOffset: 4.5,
        ampX: 90,
        ampY: 120,
        ampR: 1.8,
        parallax: 0.55,
        size: 220,
      },
    ];

    let width = window.innerWidth;
    let height = window.innerHeight;

    let targetMouseX = 0;
    let targetMouseY = 0;
    let currentMouseX = 0;
    let currentMouseY = 0;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Remove opacity-0 immediately so they fade in
    shapes.forEach(shape => {
      const el = document.getElementById(shape.id);
      if (el) {
        el.classList.remove('opacity-0');
      }
    });

    const connectionsEl = document.getElementById('global-shapes-connections');
    if (connectionsEl) {
      connectionsEl.classList.remove('opacity-0');
    }

    window.addEventListener('resize', () => {
      width = window.innerWidth;
      height = window.innerHeight;
      if (prefersReduced) {
        updatePositions(0);
      }
    });

    if (prefersReduced) {
      updatePositions(0);
      return;
    }

    window.addEventListener('mousemove', e => {
      targetMouseX = e.clientX / width - 0.5;
      targetMouseY = e.clientY / height - 0.5;
    });

    function updatePositions(time: number) {
      currentMouseX += (targetMouseX - currentMouseX) * 0.03;
      currentMouseY += (targetMouseY - currentMouseY) * 0.03;

      const coords = shapes.map(shape => {
        const el = document.getElementById(shape.id);
        if (!el) return null;

        const scale = width < 640 ? 0.65 : 1.0;
        const size = shape.size * scale;

        const baseX = width * shape.vw - size / 2;
        const baseY = height * shape.vh - size / 2;

        const floatX = Math.sin(time * shape.speedX) * shape.ampX * scale;
        const floatY = Math.cos(time * shape.speedY) * shape.ampY * scale;
        const rotate = Math.sin(time * shape.speedR) * shape.ampR * 10;

        // Mouse Parallax displacement
        const pX = currentMouseX * shape.parallax * 60;
        const pY = currentMouseY * shape.parallax * 60;

        const totalX = baseX + floatX + pX;
        const totalY = baseY + floatY + pY;

        el.style.transform = `translate3d(${totalX}px, ${totalY}px, 0) rotate(${rotate}deg)`;

        // Gentle opacity breathing between 0.75 and 1.05 of base opacity
        const pulse = 0.9 + Math.sin(time * shape.pulseSpeed + shape.pulseOffset) * 0.15;
        el.style.opacity = String(pulse);

        return {
          x: totalX + size / 2,
          y: totalY + size / 2,
        };
      });

      // Connections Update
      const connections = [
        { from: 0, to: 1, lineId: 'g-line-1' },
        { from: 1, to: 3, lineId: 'g-line-2' },
        { from: 3, to: 2, lineId: 'g-line-3' },
        { from: 2, to: 0, lineId: 'g-line-4' },
      ];

      connections.forEach(conn => {
        const fromCoord = coords[conn.from];
        const toCoord = coords[conn.to];
        const line = document.getElementById(conn.lineId);

        if (fromCoord && toCoord && line) {
          line.setAttribute('x1', String(fromCoord.x));
          line.setAttribute('y1', String(fromCoord.y));
          line.setAttribute('x2', String(toCoord.x));
          line.setAttribute('y2', String(toCoord.y));
        }
      });
    }

    let frameId: number;
    function loop(time: number) {
      updatePositions(time);
      frameId = requestAnimationFrame(loop);
    }

    requestAnimationFrame(loop);
  })();
</script>
