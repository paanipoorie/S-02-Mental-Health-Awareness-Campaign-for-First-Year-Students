---
import { NotificationBell } from '@components/notifications/NotificationBell';
import { NotificationToast } from '@components/notifications/NotificationToast';
import Brand from './Brand.astro';

interface Props {
  currentRole?: 'STUDENT' | 'MENTOR' | 'ADMIN' | null;
}

const { currentRole = null } = Astro.props;
---

<header class="bg-background-100 sticky top-0 z-50 border-b border-gray-200 py-3">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-10 items-center justify-between">
      <div class="flex items-center gap-2">
        <Brand currentRole={currentRole} />
      </div>

      <nav class="hidden items-center gap-1 md:flex" aria-label="Main Navigation">
        <!-- Student Links -->
        <div
          id="nav-links-student"
          class="hidden items-center gap-1"
        >
          <a
            href="/dashboard"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Dashboard
          </a>
          <a
            href="/posts"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Discussions
          </a>
          <a
            href="/chat"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Peer Chat
          </a>
          <a
            href="/events"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Events
          </a>
        </div>

        <!-- Mentor Links -->
        <div
          id="nav-links-mentor"
          class="hidden items-center gap-1"
        >
          <a
            href="/mentor/dashboard"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Dashboard
          </a>
          <a
            href="/posts"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Discussions
          </a>
          <a
            href="/chat"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Peer Chat
          </a>
          <a
            href="/events"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Events
          </a>
        </div>
      </nav>

      <div class="flex items-center gap-3">
        <!-- Loading Placeholder -->
        <div
          id="nav-loading-placeholder"
          class="flex items-center gap-3"
        >
          <div class="h-4 w-12 animate-pulse rounded-sm bg-gray-200"></div>
          <div class="h-4 w-16 animate-pulse rounded-sm bg-gray-200"></div>
        </div>

        <!-- Logged-in Controls -->
        <div id="nav-user-controls" class="hidden items-center gap-3">
          <NotificationBell client:load />
          <button
            id="logout-btn"
            class="hover:text-gray-1000 cursor-pointer border-none bg-transparent p-0 text-sm font-medium text-gray-700 transition-colors focus-visible:outline-none"
          >
            Logout
          </button>
        </div>

        <!-- Logged-out Controls -->
        <div
          id="nav-guest-controls"
          class="hidden items-center gap-2"
        >
          <a
            href="/login"
            class="bg-background-100 text-button-12 rounded-sm border border-gray-200 px-3 py-1.5 font-medium text-gray-700 transition-colors hover:bg-gray-100 focus-visible:outline-none"
          >
            Sign In
          </a>
          <a
            href="/register"
            class="bg-primary text-button-12 text-background-100 rounded-sm px-3 py-1.5 font-semibold transition-colors hover:bg-gray-800 focus-visible:outline-none"
          >
            Get Started
          </a>
        </div>
      </div>

      <script is:inline>
        (function () {
          const rawUser = localStorage.getItem('caps_user_profile');
          const hasToken = !!localStorage.getItem('caps_access_token');
          let role = null;
          if (hasToken && rawUser) {
            try {
              role = JSON.parse(rawUser).role;
            } catch (e) {}
          }

          const brandLink = document.getElementById('brand-link');
          if (brandLink) {
            if (role === 'STUDENT') {
              brandLink.href = '/dashboard';
            } else if (role === 'MENTOR') {
              brandLink.href = '/mentor/dashboard';
            } else if (role === 'ADMIN') {
              brandLink.href = '/admin/dashboard';
            } else {
              brandLink.href = '/';
            }
          }

          if (role) {
            document.getElementById('nav-links-student')?.classList.add('hidden');
            document.getElementById('nav-links-student')?.classList.remove('flex');
            document.getElementById('nav-links-mentor')?.classList.add('hidden');
            document.getElementById('nav-links-mentor')?.classList.remove('flex');
            document.getElementById('nav-guest-controls')?.classList.add('hidden');
            document.getElementById('nav-guest-controls')?.classList.remove('flex');
            document.getElementById('nav-loading-placeholder')?.classList.add('hidden');
            document.getElementById('nav-loading-placeholder')?.classList.remove('flex');

            if (role === 'STUDENT') {
              const studentNav = document.getElementById('nav-links-student');
              if (studentNav) {
                studentNav.classList.remove('hidden');
                studentNav.classList.add('flex');
              }
            } else if (role === 'MENTOR') {
              const mentorNav = document.getElementById('nav-links-mentor');
              if (mentorNav) {
                mentorNav.classList.remove('hidden');
                mentorNav.classList.add('flex');
              }
            }

            const userControls = document.getElementById('nav-user-controls');
            if (userControls) {
              userControls.classList.remove('hidden');
              userControls.classList.add('flex');
            }
          } else {
            // Logged out
            document.getElementById('nav-loading-placeholder')?.classList.add('hidden');
            document.getElementById('nav-loading-placeholder')?.classList.remove('flex');
            
            const userControls = document.getElementById('nav-user-controls');
            if (userControls) {
              userControls.classList.add('hidden');
              userControls.classList.remove('flex');
            }

            const guestControls = document.getElementById('nav-guest-controls');
            if (guestControls) {
              guestControls.classList.remove('hidden');
              guestControls.classList.add('flex');
            }
          }
        })();
      </script>
    </div>
  </div>
</header>

<!-- Notification Toast -->
<NotificationToast client:load />

<script>
  import { $user, $isLoading, fetchCurrentUser, clearAuthUser } from '../../stores/authStore';
  import { api } from '../../lib/api';

  const studentNav = document.getElementById('nav-links-student');
  const mentorNav = document.getElementById('nav-links-mentor');
  const userControls = document.getElementById('nav-user-controls');
  const guestControls = document.getElementById('nav-guest-controls');
  const loadingPlaceholder = document.getElementById('nav-loading-placeholder');
  const brandLink = document.getElementById('brand-link');

  function updateNavbar(user: any, loading: boolean) {
    if (loading) {
      loadingPlaceholder?.classList.remove('hidden');
      loadingPlaceholder?.classList.add('flex');
      
      studentNav?.classList.add('hidden');
      studentNav?.classList.remove('flex');
      mentorNav?.classList.add('hidden');
      mentorNav?.classList.remove('flex');
      userControls?.classList.add('hidden');
      userControls?.classList.remove('flex');
      guestControls?.classList.add('hidden');
      guestControls?.classList.remove('flex');
      return;
    }

    loadingPlaceholder?.classList.add('hidden');
    loadingPlaceholder?.classList.remove('flex');

    if (user) {
      guestControls?.classList.add('hidden');
      guestControls?.classList.remove('flex');

      if (user.role === 'STUDENT') {
        studentNav?.classList.remove('hidden');
        studentNav?.classList.add('flex');
        mentorNav?.classList.add('hidden');
        mentorNav?.classList.remove('flex');
        if (brandLink) brandLink.setAttribute('href', '/dashboard');
      } else if (user.role === 'MENTOR') {
        mentorNav?.classList.remove('hidden');
        mentorNav?.classList.add('flex');
        studentNav?.classList.add('hidden');
        studentNav?.classList.remove('flex');
        if (brandLink) brandLink.setAttribute('href', '/mentor/dashboard');
      } else if (user.role === 'ADMIN') {
        studentNav?.classList.add('hidden');
        studentNav?.classList.remove('flex');
        mentorNav?.classList.add('hidden');
        mentorNav?.classList.remove('flex');
        if (brandLink) brandLink.setAttribute('href', '/admin/dashboard');
      }

      userControls?.classList.remove('hidden');
      userControls?.classList.add('flex');
    } else {
      studentNav?.classList.add('hidden');
      studentNav?.classList.remove('flex');
      mentorNav?.classList.add('hidden');
      mentorNav?.classList.remove('flex');
      userControls?.classList.add('hidden');
      userControls?.classList.remove('flex');

      guestControls?.classList.remove('hidden');
      guestControls?.classList.add('flex');
      if (brandLink) brandLink.setAttribute('href', '/');
    }
  }

  // Subscribe to changes
  $user.subscribe(user => {
    updateNavbar(user, $isLoading.get());
  });

  $isLoading.subscribe(loading => {
    updateNavbar($user.get(), loading);
  });

  // Verify token Validity on load
  const hasToken = !!localStorage.getItem('caps_access_token');
  if (hasToken) {
    fetchCurrentUser();
  } else {
    clearAuthUser();
  }

  // Logout action
  const logoutBtn = document.getElementById('logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      try {
        await api.post('/auth/logout');
      } catch (err) {
        console.error('Logout error:', err);
      } finally {
        clearAuthUser();
        window.location.href = '/login';
      }
    });
  }

  // Highlight active main navbar link
  const currentPath = window.location.pathname;
  const navLinks = document.querySelectorAll('header nav a');
  navLinks.forEach(link => {
    const href = link.getAttribute('href');
    if (href) {
      if (href === currentPath || (href !== '/' && currentPath.startsWith(href))) {
        link.classList.add('active-nav-link');
        link.setAttribute('aria-current', 'page');
      }
    }
  });
</script>
