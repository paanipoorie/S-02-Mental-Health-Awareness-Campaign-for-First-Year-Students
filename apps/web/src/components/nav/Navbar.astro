---
import { NotificationBell } from '@components/notifications/NotificationBell';
import { NotificationToast } from '@components/notifications/NotificationToast';
import Brand from './Brand.astro';

interface Props {
  currentRole?: 'STUDENT' | 'MENTOR' | 'ADMIN' | null;
}

const { currentRole = null } = Astro.props;
---

<header class="bg-background-100 sticky top-0 z-50 border-b border-gray-200 py-3">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-10 items-center justify-between">
      <div class="flex items-center gap-2">
        <Brand currentRole={currentRole} />
      </div>

      <nav class="hidden items-center gap-1 md:flex" aria-label="Main Navigation">
        <!-- Student Links -->
        <div
          id="nav-links-student"
          class={`items-center gap-1 ${currentRole === 'STUDENT' ? 'flex' : 'hidden'}`}
        >
          <a
            href="/dashboard"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Dashboard
          </a>
          <a
            href="/posts"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Discussions
          </a>
          <a
            href="/chat"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Peer Chat
          </a>
          <a
            href="/events"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Events
          </a>
        </div>

        <!-- Mentor Links -->
        <div
          id="nav-links-mentor"
          class={`items-center gap-1 ${currentRole === 'MENTOR' ? 'flex' : 'hidden'}`}
        >
          <a
            href="/mentor/dashboard"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Dashboard
          </a>
          <a
            href="/posts"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Discussions
          </a>
          <a
            href="/chat"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Peer Chat
          </a>
          <a
            href="/events"
            class="text-label-14 rounded-sm px-3 py-1.5 font-medium text-slate-300 transition-colors hover:text-white focus-visible:outline-none"
          >
            Events
          </a>
        </div>
      </nav>

      <div class="flex items-center gap-3">
        <!-- Logged-in Controls -->
        <div id="nav-user-controls" class={`items-center gap-3 ${currentRole ? 'flex' : 'hidden'}`}>
          <NotificationBell client:load />
          <button
            id="logout-btn"
            class="hover:text-gray-1000 cursor-pointer border-none bg-transparent p-0 text-sm font-medium text-gray-700 transition-colors focus-visible:outline-none"
          >
            Logout
          </button>
        </div>

        <!-- Logged-out Controls -->
        <div
          id="nav-guest-controls"
          class={`items-center gap-2 ${!currentRole ? 'flex' : 'hidden'}`}
        >
          <a
            href="/login"
            class="bg-background-100 text-button-12 rounded-sm border border-gray-200 px-3 py-1.5 font-medium text-gray-700 transition-colors hover:bg-gray-100 focus-visible:outline-none"
          >
            Sign In
          </a>
          <a
            href="/register"
            class="bg-primary text-button-12 text-background-100 rounded-sm px-3 py-1.5 font-semibold transition-colors hover:bg-gray-800 focus-visible:outline-none"
          >
            Get Started
          </a>
        </div>
      </div>

      <script is:inline>
        (function () {
          const rawUser = localStorage.getItem('caps_user_profile');
          let role = null;
          if (rawUser) {
            try {
              role = JSON.parse(rawUser).role;
            } catch (e) {}
          }

          const brandLink = document.getElementById('brand-link');
          if (brandLink) {
            if (role === 'STUDENT') {
              brandLink.href = '/dashboard';
            } else if (role === 'MENTOR') {
              brandLink.href = '/mentor/dashboard';
            } else if (role === 'ADMIN') {
              brandLink.href = '/admin/dashboard';
            } else {
              brandLink.href = '/';
            }
          }

          if (role) {
            document.getElementById('nav-links-student')?.classList.add('hidden');
            document.getElementById('nav-links-student')?.classList.remove('flex');
            document.getElementById('nav-links-mentor')?.classList.add('hidden');
            document.getElementById('nav-links-mentor')?.classList.remove('flex');
            document.getElementById('nav-guest-controls')?.classList.add('hidden');
            document.getElementById('nav-guest-controls')?.classList.remove('flex');

            if (role === 'STUDENT') {
              const studentNav = document.getElementById('nav-links-student');
              if (studentNav) {
                studentNav.classList.remove('hidden');
                studentNav.classList.add('flex');
              }
            } else if (role === 'MENTOR') {
              const mentorNav = document.getElementById('nav-links-mentor');
              if (mentorNav) {
                mentorNav.classList.remove('hidden');
                mentorNav.classList.add('flex');
              }
            }

            const userControls = document.getElementById('nav-user-controls');
            if (userControls) {
              userControls.classList.remove('hidden');
              userControls.classList.add('flex');
            }
          } else {
            const userControls = document.getElementById('nav-user-controls');
            if (userControls) {
              userControls.classList.add('hidden');
              userControls.classList.remove('flex');
            }

            const guestControls = document.getElementById('nav-guest-controls');
            if (guestControls) {
              guestControls.classList.remove('hidden');
              guestControls.classList.add('flex');
            }
          }
        })();
      </script>
    </div>
  </div>
</header>

<!-- Notification Toast -->
{currentRole && <NotificationToast client:load />}

<script>
  import { clearAuthUser } from '../../stores/authStore';
  import { api } from '../../lib/api';

  const logoutBtn = document.getElementById('logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      try {
        await api.post('/auth/logout');
      } catch (err) {
        console.error('Logout error:', err);
      } finally {
        clearAuthUser();
        window.location.href = '/login';
      }
    });
  }

  // Highlight active main navbar link
  const currentPath = window.location.pathname;
  const navLinks = document.querySelectorAll('header nav a');
  navLinks.forEach(link => {
    const href = link.getAttribute('href');
    if (href) {
      if (href === currentPath || (href !== '/' && currentPath.startsWith(href))) {
        link.classList.add('active-nav-link');
        link.setAttribute('aria-current', 'page');
      }
    }
  });
</script>
