---
import RoleBadge from './RoleBadge.astro';
import { NotificationBell } from '@components/notifications/NotificationBell';
import { NotificationToast } from '@components/notifications/NotificationToast';

interface Props {
  currentRole?: 'STUDENT' | 'MENTOR' | 'ADMIN' | null;
  displayName?: string;
  isVerified?: boolean;
}

const { currentRole = null, displayName = '', isVerified = false } = Astro.props;
---

<header
  class="sticky top-0 z-50 border-b border-gray-200 bg-background-100 py-3 transition-colors"
>
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex h-10 items-center justify-between">
      <!-- Logo & Brand -->
      <div class="flex items-center gap-2">
        <a href="/" class="flex items-center gap-2 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-700 rounded-sm">
          <svg class="h-5 w-5 text-gray-1000" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2.5"
              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"
            ></path>
          </svg>
          <div class="flex flex-col">
            <span class="text-label-14 font-bold tracking-tight text-gray-1000">
              Campus Peer Support
            </span>
          </div>
        </a>
      </div>

      <!-- Navigation Links based on role -->
      <nav class="hidden items-center gap-1 md:flex" aria-label="Main Navigation">
        {
          currentRole === 'STUDENT' && (
            <>
              <a
                href="/dashboard"
                class="text-label-14 font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-1000 rounded-sm px-3 py-1.5 transition-colors focus-visible:outline-none"
              >
                Dashboard
              </a>
              <a
                href="/posts"
                class="text-label-14 font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-1000 rounded-sm px-3 py-1.5 transition-colors focus-visible:outline-none"
              >
                Discussions
              </a>
              <a
                href="/chat"
                class="text-label-14 font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-1000 rounded-sm px-3 py-1.5 transition-colors focus-visible:outline-none"
              >
                Peer Chat
              </a>
              <a
                href="/workshops"
                class="text-label-14 font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-1000 rounded-sm px-3 py-1.5 transition-colors focus-visible:outline-none"
              >
                Workshops
              </a>
              <a
                href="/resources"
                class="text-label-14 font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-1000 rounded-sm px-3 py-1.5 transition-colors focus-visible:outline-none"
              >
                Resources
              </a>
            </>
          )
        }

        {
          currentRole === 'MENTOR' && (
            <>
              <a
                href="/mentor/dashboard"
                class="text-label-14 font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-1000 rounded-sm px-3 py-1.5 transition-colors focus-visible:outline-none"
              >
                Dashboard
              </a>
              <a
                href="/mentor/chats"
                class="text-label-14 font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-1000 rounded-sm px-3 py-1.5 transition-colors focus-visible:outline-none"
              >
                Active Chats
              </a>
              <a
                href="/mentor/workshops"
                class="text-label-14 font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-1000 rounded-sm px-3 py-1.5 transition-colors focus-visible:outline-none"
              >
                Hosted Workshops
              </a>
              <a
                href="/resources"
                class="text-label-14 font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-1000 rounded-sm px-3 py-1.5 transition-colors focus-visible:outline-none"
              >
                Resources
              </a>
            </>
          )
        }

        {
          currentRole === 'ADMIN' && (
            <>
              <a
                href="/admin/dashboard"
                class="text-label-14 font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-1000 rounded-sm px-3 py-1.5 transition-colors focus-visible:outline-none"
              >
                Dashboard
              </a>
              <a
                href="/admin/mentors"
                class="text-label-14 font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-1000 rounded-sm px-3 py-1.5 transition-colors focus-visible:outline-none"
              >
                Verify Mentors
              </a>
              <a
                href="/resources"
                class="text-label-14 font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-1000 rounded-sm px-3 py-1.5 transition-colors focus-visible:outline-none"
              >
                Manage Resources
              </a>
            </>
          )
        }

        {
          !currentRole && (
            <>
              <a
                href="/resources"
                class="text-label-14 font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-1000 rounded-sm px-3 py-1.5 transition-colors focus-visible:outline-none"
              >
                Resources
              </a>
            </>
          )
        }
      </nav>

      <!-- Notification Bell (authenticated users only) -->
      {
        currentRole && (
          <NotificationBell client:load />
        )
      }

      <!-- Notification Toast -->
      {
        currentRole && (
          <NotificationToast client:load />
        )
      }

      <!-- User Action / Auth CTA -->
      <div class="flex items-center gap-3">
        {
          currentRole ? (
            <div class="flex items-center gap-3 rounded-sm border border-gray-200 bg-background-100 px-3 py-1 text-label-13 text-gray-700">
              <RoleBadge role={currentRole} isVerified={isVerified} />
              {displayName && (
                <span class="max-w-[140px] truncate font-semibold text-gray-900">
                  {displayName}
                </span>
              )}
              <button
                id="logout-btn"
                class="ml-1 font-medium text-red-700 hover:text-red-900 hover:underline cursor-pointer border-none bg-transparent p-0 text-label-13 transition-colors focus-visible:outline-none"
                title="Sign Out"
              >
                Logout
              </button>
            </div>
          ) : (
            <div class="flex items-center gap-2">
              <a
                href="/login"
                class="rounded-sm border border-gray-200 bg-background-100 px-3 py-1.5 text-button-12 font-medium text-gray-700 transition-colors hover:bg-gray-100 focus-visible:outline-none"
              >
                Sign In
              </a>
              <a
                href="/register"
                class="rounded-sm bg-primary px-3 py-1.5 text-button-12 font-semibold text-background-100 transition-colors hover:bg-gray-800 focus-visible:outline-none"
              >
                Get Started
              </a>
            </div>
          )
        }
      </div>
    </div>
  </div>
</header>

<script>
  import { clearAuthUser } from '../../stores/authStore';

  const logoutBtn = document.getElementById('logout-btn');
  if (logoutBtn) {
    logoutBtn.addEventListener('click', async () => {
      try {
        await fetch('http://localhost:3000/api/auth/logout', { method: 'POST' });
      } catch (err) {
        console.error('Logout error:', err);
      } finally {
        clearAuthUser();
        window.location.href = '/login';
      }
    });
  }
</script>
