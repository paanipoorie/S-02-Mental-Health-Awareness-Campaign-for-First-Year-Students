---
interface Props {
  role?: string;
  isVerified?: boolean;
  className?: string;
}

const { role = 'STUDENT', isVerified = false, className = '' } = Astro.props;

let badgeText = 'Student';
let badgeStyles = 'bg-teal-100/50 text-teal-800 border-teal-300';

if (role === 'MENTOR') {
  badgeText = isVerified ? 'Verified Mentor' : 'Mentor';
  badgeStyles = isVerified
    ? 'bg-purple-100/50 text-purple-800 border-purple-300'
    : 'bg-gray-100 text-gray-800 border-gray-300';
} else if (role === 'ADMIN') {
  badgeText = 'Admin';
  badgeStyles = 'bg-red-100/50 text-red-800 border-red-300';
}
---

<span
  class={`inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-xs font-semibold border transition-all ${badgeStyles} ${className}`}
>
  {
    role === 'MENTOR' && isVerified && (
      <svg class="h-3 w-3 fill-current text-purple-700" viewBox="0 0 20 20">
        <path
          fill-rule="evenodd"
          d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
          clip-rule="evenodd"
        />
      </svg>
    )
  }
  {badgeText}
</span>
