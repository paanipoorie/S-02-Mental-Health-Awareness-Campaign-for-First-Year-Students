---
import { MentorAvailabilityStatus } from '@campus-peer-support/shared-types/enums';

interface Props {
  users: Array<{
    id: string;
    universityEmail: string;
    displayName: string;
    role: string;
    isActive: boolean;
    isVerifiedMentor: boolean;
    createdAt: Date | string;
    anonymousDisplayName: string | null;
    avatarSeed: number | null;
    department: string | null;
    bio: string | null;
    specialties: string[];
    availabilityStatus: MentorAvailabilityStatus | null;
    lastSeenAt: Date | string | null;
    _count: {
      posts: number;
      chatThreads: number;
      meetings: number;
      workshops: number;
    };
  }>;
  type: 'mentors' | 'students';
  pagination: {
    page: number;
    limit: number;
    total: number;
    totalPages: number;
  };
  search: string;
  filters: Record<string, string>;
  onPageChange: (page: number) => void;
  onSearchChange: (search: string) => void;
  onFilterChange: (filters: Record<string, string>) => void;
  onVerifyMentor?: (userId: string, isVerified: boolean) => void;
  onToggleStatus?: (userId: string, isActive: boolean) => void;
  isLoading?: boolean;
}
---

<script>
  function formatDate(date: Date | string) {
    return new Date(date).toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });
  }

  function getStatusBadge(isActive: boolean) {
    return isActive
      ? '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>'
      : '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-red-100 text-red-800">Inactive</span>';
  }

  function getVerificationBadge(isVerified: boolean) {
    return isVerified
      ? '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-800"><svg class="w-3 h-3 inline mr-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg> Verified</span>'
      : '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800"><svg class="w-3 h-3 inline mr-0.5 animate-pulse" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Pending</span>';
  }

  function getAvailabilityBadge(status: string | null) {
    if (!status)
      return '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600">\u2014</span>';
    const statusMap: Record<string, { bg: string; text: string; label: string }> = {
      AVAILABLE: {
        bg: 'bg-green-100',
        text: 'text-green-800',
        label:
          '<svg class="w-3 h-3 inline mr-0.5 fill-green-500" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg> Available',
      },
      BUSY: {
        bg: 'bg-amber-100',
        text: 'text-amber-800',
        label:
          '<svg class="w-3 h-3 inline mr-0.5 fill-amber-500" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg> Busy',
      },
      OFFLINE: {
        bg: 'bg-slate-100',
        text: 'text-slate-600',
        label:
          '<svg class="w-3 h-3 inline mr-0.5 fill-slate-400" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/></svg> Offline',
      },
    };
    const s = statusMap[status] || { bg: 'bg-slate-100', text: 'text-slate-600', label: status };
    return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${s.bg} ${s.text}">${s.label}</span>`;
  }

  function getAvatarSeed(seed: number | null) {
    if (!seed)
      return '<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>';
    const avatars = [
      '&#x1F426;',
      '&#x1F985;',
      '&#x1F989;',
      '&#x1F99C;',
      '&#x1F427;',
      '&#x1F9A2;',
      '&#x1F9A9;',
      '&#x1F424;',
    ];
    return avatars[seed % avatars.length];
  }
</script>

<div class="dashboard-card">
  <!-- Toolbar -->
  <div
    class="mb-6 flex flex-col gap-4 rounded-lg border border-slate-200 bg-slate-50 p-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="relative w-full max-w-xs">
      <label for="search" class="sr-only">Search users</label>
      <input
        type="search"
        id="search"
        placeholder="Search by name, email, department..."
        value={search}
        class="w-full rounded-lg border border-slate-300 bg-white py-2 pl-10 pr-4 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500"
        oninput={onSearchChange}
      />
      <svg
        class="absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      {
        type === 'mentors' && (
          <>
            <select
              id="verification-filter"
              value={filters.isVerified || ''}
              class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500"
              onchange={e => onFilterChange({ ...filters, isVerified: e.target.value })}
            >
              <option value="">All Verification</option>
              <option value="true">Verified Only</option>
              <option value="false">Pending Only</option>
            </select>
            <select
              id="availability-filter"
              value={filters.availabilityStatus || ''}
              class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500"
              onchange={e => onFilterChange({ ...filters, availabilityStatus: e.target.value })}
            >
              <option value="">All Availability</option>
              <option value="AVAILABLE">Available</option>
              <option value="BUSY">Busy</option>
              <option value="OFFLINE">Offline</option>
            </select>
          </>
        )
      }
      {
        type === 'students' && (
          <select
            id="status-filter"
            value={filters.isActive || ''}
            class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500"
            onchange={e => onFilterChange({ ...filters, isActive: e.target.value })}
          >
            <option value="">All Status</option>
            <option value="true">Active</option>
            <option value="false">Inactive</option>
          </select>
        )
      }
    </div>
  </div>

  <!-- Table -->
  <div class="overflow-x-auto">
    {
      isLoading ? (
        <div class="table-container">
          <table class="w-full" role="table">
            <thead>
              <tr class="border-b border-slate-200">
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                  User
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Role
                </th>
                {type === 'mentors' && (
                  <>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                      Department
                    </th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                      Verification
                    </th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                      Availability
                    </th>
                  </>
                )}
                {type === 'students' && (
                  <>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                      Status
                    </th>
                    <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                      Posts
                    </th>
                  </>
                )}
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Joined
                </th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              {Array.from({ length: 5 }).map((_, i) => (
                <tr class="animate-pulse">
                  <td class="px-4 py-4">
                    <div class="flex items-center gap-3">
                      <div class="h-10 w-10 rounded-full bg-slate-200" />
                      <div>
                        <div class="h-4 w-32 rounded bg-slate-200" />
                        <div class="mt-1 h-3 w-24 rounded bg-slate-200" />
                      </div>
                    </div>
                  </td>
                  <td class="px-4 py-4">
                    <div class="h-4 w-20 rounded bg-slate-200" />
                  </td>
                  {type === 'mentors' && (
                    <>
                      <td class="px-4 py-4">
                        <div class="h-4 w-24 rounded bg-slate-200" />
                      </td>
                      <td class="px-4 py-4">
                        <div class="h-4 w-24 rounded bg-slate-200" />
                      </td>
                      <td class="px-4 py-4">
                        <div class="h-4 w-20 rounded bg-slate-200" />
                      </td>
                    </>
                  )}
                  {type === 'students' && (
                    <>
                      <td class="px-4 py-4">
                        <div class="h-4 w-20 rounded bg-slate-200" />
                      </td>
                      <td class="px-4 py-4">
                        <div class="h-4 w-12 rounded bg-slate-200" />
                      </td>
                    </>
                  )}
                  <td class="px-4 py-4">
                    <div class="h-4 w-24 rounded bg-slate-200" />
                  </td>
                  <td class="px-4 py-4 text-right">
                    <div class="mx-auto h-6 w-24 rounded bg-slate-200" />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : users.length === 0 ? (
        <div class="py-12 text-center">
          <svg
            class="mx-auto h-12 w-12 text-slate-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"
            />
          </svg>
          <h3 class="mt-2 text-lg font-medium text-slate-900">No users found</h3>
          <p class="mt-1 text-sm text-slate-500">Try adjusting your search or filters.</p>
        </div>
      ) : (
        <table class="w-full" role="table">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                User
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Role
              </th>
              {type === 'mentors' && (
                <>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Department
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Verification
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Availability
                  </th>
                </>
              )}
              {type === 'students' && (
                <>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Status
                  </th>
                  <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                    Posts
                  </th>
                </>
              )}
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Joined
              </th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            {users.map(user => (
              <tr class="transition-colors hover:bg-slate-50">
                <td class="px-4 py-4">
                  <div class="flex items-center gap-3">
                    <span
                      class="flex h-10 w-10 items-center justify-center rounded-full bg-slate-100 text-2xl"
                      aria-hidden="true"
                    >
                      {getAvatarSeed(user.avatarSeed)}
                    </span>
                    <div>
                      <p class="font-medium text-slate-900">
                        {user.anonymousDisplayName || 'Anonymous'}
                      </p>
                      <p class="max-w-xs truncate text-sm text-slate-500">{user.universityEmail}</p>
                    </div>
                  </div>
                </td>
                <td class="px-4 py-4">
                  <span class="inline-flex items-center rounded-full bg-slate-100 px-2.5 py-0.5 text-xs font-medium text-slate-700">
                    {user.role === 'MENTOR'
                      ? '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg> Mentor'
                      : user.role === 'STUDENT'
                        ? '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg> Student'
                        : '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Admin'}
                  </span>
                </td>
                {type === 'mentors' && (
                  <>
                    <td class="px-4 py-4 text-sm text-slate-600">{user.department || '\u2014'}</td>
                    <td class="px-4 py-4">{getVerificationBadge(user.isVerifiedMentor)}</td>
                    <td class="px-4 py-4">{getAvailabilityBadge(user.availabilityStatus)}</td>
                  </>
                )}
                {type === 'students' && (
                  <>
                    <td class="px-4 py-4">{getStatusBadge(user.isActive)}</td>
                    <td class="px-4 py-4 text-sm text-slate-600">{user._count.posts}</td>
                  </>
                )}
                <td class="px-4 py-4 text-sm text-slate-500">{formatDate(user.createdAt)}</td>
                <td class="px-4 py-4 text-right">
                  <div class="flex items-center justify-end gap-2">
                    {type === 'mentors' && onVerifyMentor && (
                      <button
                        type="button"
                        onclick={() => onVerifyMentor(user.id, !user.isVerifiedMentor)}
                        class={`rounded-lg px-3 py-1.5 text-xs font-medium transition-colors ${
                          user.isVerifiedMentor
                            ? 'bg-amber-100 text-amber-700 hover:bg-amber-200'
                            : 'bg-emerald-100 text-emerald-700 hover:bg-emerald-200'
                        }`}
                      >
                        {user.isVerifiedMentor ? 'Unverify' : 'Verify'}
                      </button>
                    )}
                    {type === 'students' && onToggleStatus && (
                      <button
                        type="button"
                        onclick={() => onToggleStatus(user.id, !user.isActive)}
                        class={`rounded-lg px-3 py-1.5 text-xs font-medium transition-colors ${
                          user.isActive
                            ? 'bg-red-100 text-red-700 hover:bg-red-200'
                            : 'bg-green-100 text-green-700 hover:bg-green-200'
                        }`}
                      >
                        {user.isActive ? 'Deactivate' : 'Activate'}
                      </button>
                    )}
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }

    <!-- Pagination -->
    {
      pagination.totalPages > 1 && !isLoading && (
        <div class="flex items-center justify-between border-t border-slate-200 px-4 py-4">
          <p class="text-sm text-slate-600">
            Showing page {pagination.page} of {pagination.totalPages} ({pagination.total} total)
          </p>
          <div class="flex items-center gap-2">
            <button
              type="button"
              onclick={() => onPageChange(pagination.page - 1)}
              disabled={pagination.page === 1}
              class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
            >
              Previous
            </button>
            <button
              type="button"
              onclick={() => onPageChange(pagination.page + 1)}
              disabled={pagination.page === pagination.totalPages}
              class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
            >
              Next
            </button>
          </div>
        </div>
      )
    }
  </div>
</div>
