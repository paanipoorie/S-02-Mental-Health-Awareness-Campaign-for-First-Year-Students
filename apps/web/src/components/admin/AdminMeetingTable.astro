---
interface Props {
  meetings: Array<{
    id: string;
    title: string;
    description: string;
    hostType: string;
    hostDisplayName: string | null;
    date: string;
    time: string;
    durationMinutes: number;
    meetingType: string;
    meetingLink: string | null;
    location: string | null;
    category: string;
    attendeeCount: number;
    createdAt: string;
  }>;
  pagination: {
    page: number;
    limit: number;
    total: number;
    totalPages: number;
  };
  filters: {
    hostType?: string;
    meetingType?: string;
    category?: string;
    upcoming?: boolean;
    search?: string;
  };
  onFilterChange: (filters: any) => void;
  onPageChange: (page: number) => void;
  onDelete: (id: string) => void;
  isLoading?: boolean;
  search?: string;
  onSearchChange: (search: string) => void;
}
---

<script>
  function formatDate(dateStr: string) {
    const date = new Date(dateStr);
    return date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });
  }

  function formatTime(timeStr: string) {
    const [hours, minutes] = timeStr.split(':');
    const hour = parseInt(hours);
    const ampm = hour >= 12 ? 'PM' : 'AM';
    const displayHour = hour % 12 || 12;
    return `${displayHour}:${minutes} ${ampm}`;
  }

  function getHostTypeBadge(hostType: string) {
    return hostType === 'STUDENT'
      ? '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-800"><svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg> Student</span>'
      : '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-purple-100 text-purple-800"><svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg> Mentor</span>';
  }

  function getMeetingTypeBadge(meetingType: string) {
    return meetingType === 'ONLINE'
      ? '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800"><svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg> Online</span>'
      : '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800"><svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg> Offline</span>';
  }

  function getCategoryBadge(category: string) {
    const categoryLabels: Record<string, string> = {
      STUDY_GROUP:
        '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M2 3h6a4 4 0 014 4v14a3 3 0 00-3-3H2z"/><path d="M22 3h-6a4 4 0 00-4 4v14a3 3 0 013-3h7z"/></svg> Study Group',
      PEER_DISCUSSION:
        '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M21 11.5a8.38 8.38 0 01-.9 3.8 8.5 8.5 0 01-7.6 4.7 8.38 8.38 0 01-3.8-.9L3 21l1.9-5.7a8.38 8.38 0 01-.9-3.8 8.5 8.5 0 014.7-7.6 8.38 8.38 0 013.8-.9h.5a8.48 8.48 0 018 8v.5z"/></svg> Peer Discussion',
      MENTOR_OFFICE_HOURS:
        '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="2" y="7" width="20" height="14" rx="2" ry="2"/><path d="M16 7V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v2"/></svg> Office Hours',
      SOCIAL:
        '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg> Social',
      WORKSHOP:
        '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M14.7 6.3a1 1 0 000 1.4l1.6 1.6a1 1 0 001.4 0l3.77-3.77a6 6 0 01-7.94 7.94l-6.91 6.91a2.12 2.12 0 01-3-3l6.91-6.91a6 6 0 017.94-7.94l-3.76 3.76z"/></svg> Workshop',
      GENERAL:
        '<svg class="w-3.5 h-3.5 inline mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg> General',
    };
    const label = categoryLabels[category] || category;
    return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-700">${label}</span>`;
  }
</script>

<div class="dashboard-card">
  <!-- Toolbar -->
  <div
    class="mb-6 flex flex-col gap-4 rounded-lg border border-slate-200 bg-slate-50 p-4 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="relative w-full max-w-xs">
      <label for="search" class="sr-only">Search meetings</label>
      <input
        type="search"
        id="search"
        placeholder="Search meetings..."
        value={search}
        class="w-full rounded-lg border border-slate-300 bg-white py-2 pl-10 pr-4 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500"
        oninput={onSearchChange}
      />
      <svg
        class="absolute left-3 top-1/2 h-5 w-5 -translate-y-1/2 text-slate-400"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <select
        id="host-type-filter"
        value={filters.hostType || ''}
        class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500"
        onchange={e => onFilterChange({ ...filters, hostType: e.target.value })}
      >
        <option value="">All Host Types</option>
        <option value="STUDENT">Student</option>
        <option value="MENTOR">Mentor</option>
      </select>

      <select
        id="meeting-type-filter"
        value={filters.meetingType || ''}
        class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500"
        onchange={e => onFilterChange({ ...filters, meetingType: e.target.value })}
      >
        <option value="">All Types</option>
        <option value="ONLINE">Online</option>
        <option value="OFFLINE">Offline</option>
      </select>

      <select
        id="category-filter"
        value={filters.category || ''}
        class="rounded-lg border border-slate-300 bg-white px-3 py-2 text-sm outline-none focus:border-amber-500 focus:ring-2 focus:ring-amber-500"
        onchange={e => onFilterChange({ ...filters, category: e.target.value })}
      >
        <option value="">All Categories</option>
        <option value="STUDY_GROUP">Study Group</option>
        <option value="PEER_DISCUSSION">Peer Discussion</option>
        <option value="MENTOR_OFFICE_HOURS">Mentor Office Hours</option>
        <option value="SOCIAL">Social</option>
        <option value="WORKSHOP">Workshop</option>
        <option value="GENERAL">General</option>
      </select>

      <label class="inline-flex cursor-pointer items-center gap-2">
        <input
          type="checkbox"
          id="upcoming-filter"
          checked={filters.upcoming}
          class="h-4 w-4 rounded border-slate-300 text-amber-600 focus:ring-amber-500"
          onchange={e => onFilterChange({ ...filters, upcoming: e.target.checked })}
        />
        <span class="text-sm text-slate-700">Upcoming only</span>
      </label>
    </div>
  </div>

  <!-- Table -->
  <div class="overflow-x-auto">
    {
      isLoading ? (
        <div class="table-container">
          <table class="w-full" role="table">
            <thead>
              <tr class="border-b border-slate-200">
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Meeting
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Host
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Type
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Category
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Date & Time
                </th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Attendees
                </th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              {Array.from({ length: 5 }).map((_, i) => (
                <tr class="animate-pulse" key={i}>
                  <td class="px-4 py-4">
                    <div class="h-4 w-48 rounded bg-slate-200" />
                  </td>
                  <td class="px-4 py-4">
                    <div class="h-4 w-24 rounded bg-slate-200" />
                  </td>
                  <td class="px-4 py-4">
                    <div class="h-4 w-20 rounded bg-slate-200" />
                  </td>
                  <td class="px-4 py-4">
                    <div class="h-4 w-24 rounded bg-slate-200" />
                  </td>
                  <td class="px-4 py-4">
                    <div class="h-4 w-32 rounded bg-slate-200" />
                  </td>
                  <td class="px-4 py-4">
                    <div class="h-4 w-16 rounded bg-slate-200" />
                  </td>
                  <td class="px-4 py-4 text-right">
                    <div class="mx-auto h-6 w-24 rounded bg-slate-200" />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : meetings.length === 0 ? (
        <div class="py-12 text-center">
          <svg
            class="mx-auto h-12 w-12 text-slate-400"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="2"
              d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"
            />
          </svg>
          <h3 class="mt-2 text-lg font-medium text-slate-900">No meetings found</h3>
          <p class="mt-1 text-sm text-slate-500">Try adjusting your search or filters.</p>
        </div>
      ) : (
        <table class="w-full" role="table">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Meeting
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Host
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Type
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Category
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Date & Time
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wider text-slate-500">
                Attendees
              </th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wider text-slate-500">
                Actions
              </th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            {meetings.map(meeting => (
              <tr class="transition-colors hover:bg-slate-50" key={meeting.id}>
                <td class="px-4 py-4">
                  <p class="font-medium text-slate-900">{meeting.title}</p>
                  <p class="max-w-xs truncate text-sm text-slate-500">{meeting.description}</p>
                </td>
                <td class="px-4 py-4">
                  <div class="flex items-center gap-2">
                    {getHostTypeBadge(meeting.hostType)}
                    <span class="text-sm text-slate-600">
                      {meeting.hostDisplayName || 'Unknown'}
                    </span>
                  </div>
                </td>
                <td class="px-4 py-4">{getMeetingTypeBadge(meeting.meetingType)}</td>
                <td class="px-4 py-4">{getCategoryBadge(meeting.category)}</td>
                <td class="px-4 py-4">
                  <div class="flex items-center gap-2 text-sm text-slate-600">
                    <svg
                      class="inline h-4 w-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                    >
                      <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
                      <line x1="16" y1="2" x2="16" y2="6" />
                      <line x1="8" y1="2" x2="8" y2="6" />
                      <line x1="3" y1="10" x2="21" y2="10" />
                    </svg>{' '}
                    {formatDate(meeting.date)}
                    <svg
                      class="inline h-4 w-4"
                      fill="none"
                      stroke="currentColor"
                      viewBox="0 0 24 24"
                      stroke-width="2"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <polyline points="12 6 12 12 16 14" />
                    </svg>{' '}
                    {formatTime(meeting.time)}
                    <span>({meeting.durationMinutes} min)</span>
                  </div>
                  {meeting.meetingLink && (
                    <a
                      href={meeting.meetingLink}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="text-xs text-amber-600 hover:underline"
                    >
                      Join Link
                    </a>
                  )}
                  {meeting.location && !meeting.meetingLink && (
                    <span class="text-xs text-slate-500">
                      <svg
                        class="mr-0.5 inline h-3 w-3"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                        stroke-width="2"
                      >
                        <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z" />
                        <circle cx="12" cy="10" r="3" />
                      </svg>{' '}
                      {meeting.location}
                    </span>
                  )}
                </td>
                <td class="px-4 py-4 text-sm text-slate-600">{meeting.attendeeCount}</td>
                <td class="px-4 py-4 text-right">
                  <button
                    type="button"
                    onclick={() => onDelete(meeting.id)}
                    class="rounded-lg border border-red-200 bg-red-100 px-3 py-1.5 text-xs font-medium text-red-700 transition-colors hover:bg-red-200"
                  >
                    Force Delete
                  </button>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      )
    }

    <!-- Pagination -->
    {
      pagination.totalPages > 1 && !isLoading && (
        <div class="flex items-center justify-between border-t border-slate-200 px-4 py-4">
          <p class="text-sm text-slate-600">
            Showing page {pagination.page} of {pagination.totalPages} ({pagination.total} total)
          </p>
          <div class="flex items-center gap-2">
            <button
              type="button"
              onclick={() => onPageChange(pagination.page - 1)}
              disabled={pagination.page === 1}
              class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
            >
              Previous
            </button>
            <button
              type="button"
              onclick={() => onPageChange(pagination.page + 1)}
              disabled={pagination.page === pagination.totalPages}
              class="rounded-lg border border-slate-300 bg-white px-3 py-1.5 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-50 disabled:cursor-not-allowed disabled:opacity-50"
            >
              Next
            </button>
          </div>
        </div>
      )
    }
  </div>
</div>
