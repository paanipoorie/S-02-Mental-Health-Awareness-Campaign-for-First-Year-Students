---
import { ResourceCategory } from '@campus-peer-support/shared-types/enums';

interface Props {
  resources: Array<{
    id: string;
    title: string;
    description: string;
    category: ResourceCategory;
    content: string;
    link: string | null;
    isActive: boolean;
    createdAt: string;
    updatedAt: string;
  }>;
  pagination: {
    page: number;
    limit: number;
    total: number;
    totalPages: number;
  };
  filters: {
    category?: ResourceCategory;
    isActive?: boolean;
    search?: string;
  };
  onFilterChange: (filters: any) => void;
  onPageChange: (page: number) => void;
  onEdit: (resource: any) => void;
  onDelete: (id: string) => void;
  isLoading?: boolean;
  search?: string;
  onSearchChange: (search: string) => void;
  onCreate: () => void;
  modalOpen?: boolean;
  onClose: () => void;
  onSubmit: (formData: any) => void;
  initialData?: any;
}
---

<script>
  import { useState, useEffect } from 'react';

  function formatDate(dateStr: string) {
    const date = new Date(dateStr);
    return date.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    });
  }

  function getCategoryBadge(category: string) {
    const categoryLabels: Record<string, { label: string; bg: string; text: string }> = {
      COUNSELING_CENTER: { label: '🏥 Counseling Center', bg: 'bg-blue-100', text: 'text-blue-800' },
      EMERGENCY_CONTACTS: { label: '🚨 Emergency Contacts', bg: 'bg-red-100', text: 'text-red-800' },
      FACULTY_ADVISORS: { label: '👨‍🏫 Faculty Advisors', bg: 'bg-purple-100', text: 'text-purple-800' },
      STUDENT_WELFARE: { label: '🤝 Student Welfare', bg: 'bg-green-100', text: 'text-green-800' },
      CAMPUS_CLUBS: { label: '🎪 Campus Clubs', bg: 'bg-amber-100', text: 'text-amber-800' },
      SELF_HELP_PDFS: { label: '📄 Self-Help PDFs', bg: 'bg-indigo-100', text: 'text-indigo-800' },
      STRESS_MANAGEMENT: { label: '😌 Stress Management', bg: 'bg-teal-100', text: 'text-teal-800' },
      SLEEP_HYGIENE: { label: '😴 Sleep Hygiene', bg: 'bg-violet-100', text: 'text-violet-800' },
      EXTERNAL_HELPLINES: { label: '☎️ External Helplines', bg: 'bg-rose-100', text: 'text-rose-800' },
    };
    const c = categoryLabels[category] || { label: category, bg: 'bg-slate-100', text: 'text-slate-700' };
    return `<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium ${c.bg} ${c.text}">${c.label}</span>`;
  }

  function getStatusBadge(isActive: boolean) {
    return isActive
      ? '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-green-100 text-green-800">Active</span>'
      : '<span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-slate-100 text-slate-600">Inactive</span>';
  }

  // Resource Form Modal Component
  function ResourceFormModal({ isOpen, onClose, onSubmit, initialData }) {
    const [formData, setFormData] = useState({
      title: '',
      description: '',
      category: 'GENERAL',
      content: '',
      link: '',
      isActive: true,
    });

    const [errors, setErrors] = useState({});

    useEffect(() => {
      if (initialData) {
        setFormData({
          title: initialData.title,
          description: initialData.description,
          category: initialData.category,
          content: initialData.content,
          link: initialData.link || '',
          isActive: initialData.isActive,
        });
      } else {
        setFormData({
          title: '',
          description: '',
          category: 'GENERAL',
          content: '',
          link: '',
          isActive: true,
        });
      }
    }, [initialData, isOpen]);

    const validateForm = () => {
      const newErrors = {};
      if (!formData.title.trim()) newErrors.title = 'Title is required';
      if (!formData.description.trim()) newErrors.description = 'Description is required';
      if (!formData.content.trim()) newErrors.content = 'Content is required';
      if (formData.link && !isValidUrl(formData.link)) newErrors.link = 'Invalid URL format';
      setErrors(newErrors);
      return Object.keys(newErrors).length === 0;
    };

    const isValidUrl = (url) => {
      try {
        new URL(url);
        return true;
      } catch {
        return false;
      }
    };

    const handleSubmit = (e) => {
      e.preventDefault();
      if (validateForm()) {
        onSubmit(formData);
      }
    };

    if (!isOpen) return null;

    return (
      <div class="fixed inset-0 z-50 overflow-y-auto" role="dialog" aria-modal="true" aria-labelledby="modal-title">
        <div class="flex min-h-full items-center justify-center p-4">
          <div class="fixed inset-0 bg-black/50" onClick={onClose} aria-hidden="true" />
          <div class="relative w-full max-w-2xl bg-white rounded-xl shadow-xl">
            <div class="flex items-center justify-between p-4 border-b border-slate-200">
              <h2 id="modal-title" class="text-heading-20 font-semibold text-slate-900">
                {initialData ? 'Edit Resource' : 'Create Resource'}
              </h2>
              <button
                type="button"
                onClick={onClose}
                class="p-2 text-slate-500 hover:text-slate-700 rounded-lg hover:bg-slate-100 transition-colors"
                aria-label="Close modal"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
            <form onSubmit={handleSubmit} class="p-4 space-y-6 max-h-[70vh] overflow-y-auto">
              <div>
                <label htmlFor="title" class="block text-sm font-medium text-slate-700 mb-1">Title *</label>
                <input
                  type="text"
                  id="title"
                  value={formData.title}
                  onChange={(e) => setFormData({ ...formData, title: e.target.value })}
                  class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"
                  required
                />
                {errors.title && <p class="mt-1 text-sm text-red-600">{errors.title}</p>}
              </div>

              <div>
                <label htmlFor="description" class="block text-sm font-medium text-slate-700 mb-1">Description *</label>
                <textarea
                  id="description"
                  value={formData.description}
                  onChange={(e) => setFormData({ ...formData, description: e.target.value })}
                  rows={3}
                  class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"
                  required
                />
                {errors.description && <p class="mt-1 text-sm text-red-600">{errors.description}</p>}
              </div>

              <div>
                <label htmlFor="category" class="block text-sm font-medium text-slate-700 mb-1">Category *</label>
                <select
                  id="category"
                  value={formData.category}
                  onChange={(e) => setFormData({ ...formData, category: e.target.value })}
                  class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"
                >
                  <option value="COUNSELING_CENTER">Counseling Center</option>
                  <option value="EMERGENCY_CONTACTS">Emergency Contacts</option>
                  <option value="FACULTY_ADVISORS">Faculty Advisors</option>
                  <option value="STUDENT_WELFARE">Student Welfare</option>
                  <option value="CAMPUS_CLUBS">Campus Clubs</option>
                  <option value="SELF_HELP_PDFS">Self-Help PDFs</option>
                  <option value="STRESS_MANAGEMENT">Stress Management</option>
                  <option value="SLEEP_HYGIENE">Sleep Hygiene</option>
                  <option value="EXTERNAL_HELPLINES">External Helplines</option>
                </select>
              </div>

              <div>
                <label htmlFor="content" class="block text-sm font-medium text-slate-700 mb-1">Content *</label>
                <textarea
                  id="content"
                  value={formData.content}
                  onChange={(e) => setFormData({ ...formData, content: e.target.value })}
                  rows={6}
                  class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"
                  required
                />
                {errors.content && <p class="mt-1 text-sm text-red-600">{errors.content}</p>}
              </div>

              <div>
                <label htmlFor="link" class="block text-sm font-medium text-slate-700 mb-1">External Link (optional)</label>
                <input
                  type="url"
                  id="link"
                  value={formData.link}
                  onChange={(e) => setFormData({ ...formData, link: e.target.value })}
                  placeholder="https://example.com"
                  class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"
                />
                {errors.link && <p class="mt-1 text-sm text-red-600">{errors.link}</p>}
              </div>

              <div class="flex items-center gap-3">
                <label class="flex items-center gap-2 cursor-pointer">
                  <input
                    type="checkbox"
                    checked={formData.isActive}
                    onChange={(e) => setFormData({ ...formData, isActive: e.target.checked })}
                    class="w-4 h-4 text-amber-600 border-slate-300 rounded focus:ring-amber-500"
                  />
                  <span class="text-sm text-slate-700">Active (visible to students)</span>
                </label>
              </div>

              <div class="flex justify-end gap-3 pt-4 border-t border-slate-200">
                <button
                  type="button"
                  onClick={onClose}
                  class="px-4 py-2 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors"
                >
                  Cancel
                </button>
                <button
                  type="submit"
                  class="button-primary text-button-14 px-4 py-2"
                >
                  {initialData ? 'Save Changes' : 'Create Resource'}
                </button>
              </div>
            </form>
          </div>
        </div>
      </div>
    );
  }
</script>

<div class="dashboard-card">
  <!-- Toolbar -->
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6 p-4 bg-slate-50 rounded-lg border border-slate-200">
    <div class="relative max-w-xs w-full">
      <label for="search" class="sr-only">Search resources</label>
      <input
        type="search"
        id="search"
        placeholder="Search resources..."
        value={search}
        class="w-full pl-10 pr-4 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"
        oninput={onSearchChange}
      />
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <select
        id="category-filter"
        value={filters.category || ''}
        class="px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"
        onchange={(e) => onFilterChange({ ...filters, category: e.target.value })}
      >
        <option value="">All Categories</option>
        <option value="COUNSELING_CENTER">Counseling Center</option>
        <option value="EMERGENCY_CONTACTS">Emergency Contacts</option>
        <option value="FACULTY_ADVISORS">Faculty Advisors</option>
        <option value="STUDENT_WELFARE">Student Welfare</option>
        <option value="CAMPUS_CLUBS">Campus Clubs</option>
        <option value="SELF_HELP_PDFS">Self-Help PDFs</option>
        <option value="STRESS_MANAGEMENT">Stress Management</option>
        <option value="SLEEP_HYGIENE">Sleep Hygiene</option>
        <option value="EXTERNAL_HELPLINES">External Helplines</option>
      </select>

      <select
        id="status-filter"
        value={filters.isActive?.toString() || ''}
        class="px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white focus:ring-2 focus:ring-amber-500 focus:border-amber-500 outline-none"
        onchange={(e) => onFilterChange({ ...filters, isActive: e.target.value === 'true' ? true : e.target.value === 'false' ? false : undefined })}
      >
        <option value="">All Status</option>
        <option value="true">Active</option>
        <option value="false">Inactive</option>
      </select>

      <button
        type="button"
        onclick={onCreate}
        class="button-primary text-button-14 px-4 py-2"
      >
        + Add Resource
      </button>
    </div>
  </div>

  <!-- Table -->
  <div class="overflow-x-auto">
    {isLoading ? (
      <div class="table-container">
        <table class="w-full" role="table">
          <thead>
            <tr class="border-b border-slate-200">
              <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Resource</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Category</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
              <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Created</th>
              <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-200">
            {Array.from({ length: 5 }).map((_, i) => (
              <tr class="animate-pulse" key={i}>
                <td class="px-4 py-4"><div class="h-4 w-48 bg-slate-200 rounded" /></td>
                <td class="px-4 py-4"><div class="h-4 w-24 bg-slate-200 rounded" /></td>
                <td class="px-4 py-4"><div class="h-4 w-20 bg-slate-200 rounded" /></td>
                <td class="px-4 py-4"><div class="h-4 w-24 bg-slate-200 rounded" /></td>
                <td class="px-4 py-4 text-right"><div class="h-6 w-24 bg-slate-200 rounded mx-auto" /></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ) : resources.length === 0 ? (
      <div class="py-12 text-center">
        <svg class="mx-auto h-12 w-12 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <h3 class="mt-2 text-lg font-medium text-slate-900">No resources found</h3>
        <p class="mt-1 text-sm text-slate-500">Try adjusting your search or filters.</p>
      </div>
    ) : (
      <table class="w-full" role="table">
        <thead>
          <tr class="border-b border-slate-200">
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Resource</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Category</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Status</th>
            <th class="px-4 py-3 text-left text-xs font-semibold text-slate-500 uppercase tracking-wider">Created</th>
            <th class="px-4 py-3 text-right text-xs font-semibold text-slate-500 uppercase tracking-wider">Actions</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-200">
          {resources.map(resource => (
            <tr class="hover:bg-slate-50 transition-colors" key={resource.id}>
              <td class="px-4 py-4">
                <p class="font-medium text-slate-900">{resource.title}</p>
                <p class="text-sm text-slate-500 truncate max-w-xs">{resource.description}</p>
              </td>
              <td class="px-4 py-4">{getCategoryBadge(resource.category)}</td>
              <td class="px-4 py-4">{getStatusBadge(resource.isActive)}</td>
              <td class="px-4 py-4 text-sm text-slate-500">{formatDate(resource.createdAt)}</td>
              <td class="px-4 py-4 text-right">
                <div class="flex items-center justify-end gap-2">
                  <button
                    type="button"
                    onclick={() => onEdit(resource)}
                    class="px-3 py-1.5 text-xs font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 transition-colors"
                  >
                    Edit
                  </button>
                  <button
                    type="button"
                    onclick={() => onDelete(resource.id)}
                    class="px-3 py-1.5 text-xs font-medium text-red-700 bg-red-100 border border-red-200 rounded-lg hover:bg-red-200 transition-colors"
                  >
                    Delete
                  </button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>

      <!-- Pagination -->
      {pagination.totalPages > 1 && !isLoading && (
        <div class="flex items-center justify-between px-4 py-4 border-t border-slate-200">
          <p class="text-sm text-slate-600">
            Showing page {pagination.page} of {pagination.totalPages} ({pagination.total} total)
          </p>
          <div class="flex items-center gap-2">
            <button
              type="button"
              onclick={() => onPageChange(pagination.page - 1)}
              disabled={pagination.page === 1}
              class="px-3 py-1.5 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
            >
              Previous
            </button>
            <button
              type="button"
              onclick={() => onPageChange(pagination.page + 1)}
              disabled={pagination.page === pagination.totalPages}
              class="px-3 py-1.5 text-sm font-medium text-slate-700 bg-white border border-slate-300 rounded-lg hover:bg-slate-50 disabled:opacity-50 disabled:cursor-not-allowed transition-colors"
            >
              Next
            </button>
          </div>
        </div>
      )}
    )}
  </div>

  <!-- Resource Form Modal -->
  <ResourceFormModal
    isOpen={modalOpen}
    onClose={onClose}
    onSubmit={onSubmit}
    initialData={initialData}
  />
</div>