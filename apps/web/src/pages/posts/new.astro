---
import StudentLayout from '../../layouts/StudentLayout.astro';
import PostComposer from '../../components/posts/PostComposer.tsx';
import { AuthGuard } from '../../components/auth/AuthGuard.tsx';
import { api } from '../../lib/api';
---

<StudentLayout title="Create Post - Anonymous Feed">
  <div class="create-post-page mx-auto max-w-2xl px-4 py-10">
    <header class="page-header mb-6">
      <a
        href="/posts"
        class="back-link text-label-14 text-tertiary mb-4 inline-flex items-center gap-1 font-semibold hover:underline"
      >
        ← Back to Posts
      </a>
      <h1 class="text-heading-32 text-gray-1000 font-bold">Create Anonymous Post</h1>
      <p class="text-copy-14 mt-1 text-gray-500">
        Share your thoughts anonymously with the university community
      </p>
    </header>

    <main class="create-post-main bg-background-100 rounded-sm border border-gray-200 p-6">
      <AuthGuard client:visible />
      <PostComposer client:visible />
    </main>
  </div>
</StudentLayout>
