---
import StudentLayout from '../../layouts/StudentLayout.astro';
import PostComposer from '../../components/posts/PostComposer.tsx';
import { AuthGuard } from '../../components/auth/AuthGuard.tsx';
---

<StudentLayout title="Create Post - Anonymous Feed">
  <div class="create-post-page max-w-2xl mx-auto py-10 px-4">
    <header class="page-header mb-6">
      <a href="/posts" class="back-link text-label-14 font-semibold text-tertiary hover:underline inline-flex items-center gap-1 mb-4">
        ← Back to Posts
      </a>
      <h1 class="text-heading-32 font-bold text-gray-1000">Create Anonymous Post</h1>
      <p class="text-copy-14 text-gray-500 mt-1">Share your thoughts anonymously with the university community</p>
    </header>

    <main class="create-post-main rounded-sm border border-gray-200 bg-background-100 p-6">
      <AuthGuard client:visible />
      <PostComposer
        client:visible
        onSubmit={async data => {
          const token = localStorage.getItem('caps_access_token');
          const response = await fetch('http://localhost:3001/api/posts', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'Authorization': `Bearer ${token}`
            },
            body: JSON.stringify(data),
          });
          const result = await response.json();
          if (result.success) {
            window.location.href = `/posts/${result.data.id}`;
          } else {
            alert(result.error?.message || 'Failed to create post');
          }
        }}
      />
    </main>
  </div>
</StudentLayout>
