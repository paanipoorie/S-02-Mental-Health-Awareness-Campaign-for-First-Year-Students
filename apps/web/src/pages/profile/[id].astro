---
import StudentLayout from '../../layouts/StudentLayout.astro';
import ProfileClient from '../../components/profile/ProfileClient.tsx';

export async function getStaticPaths() {
  try {
    const { execSync } = await import('child_process');
    const path = await import('path');
    const __filename = new URL(import.meta.url).pathname;
    const __dirname = path.dirname(__filename);
    const prismaClientPath = path.resolve(
      __dirname,
      '../../../../../apps/api/node_modules/.prisma/client/index.js'
    );

    // Find workspace root
    const fs = await import('fs');
    let dir = __dirname;
    while (dir && dir !== '/' && !fs.existsSync(path.join(dir, 'pnpm-workspace.yaml'))) {
      dir = path.dirname(dir);
    }

    const stdout = execSync(
      `node -e "import { PrismaClient } from '${prismaClientPath}'; const p = new PrismaClient(); p.anonymousIdentity.findMany({ select: { id: true } }).then(idents => { console.log(JSON.stringify(idents)); p.\\$disconnect(); })"`,
      { encoding: 'utf8', cwd: dir }
    );
    const idents = JSON.parse(stdout.trim());
    return idents.map((ident: any) => ({ params: { id: ident.id } }));
  } catch (e) {
    console.error('Failed to query anonymous identities for static paths:', e);
  }
  return [];
}

const { id } = Astro.params;
---

<StudentLayout title="Anonymous Profile | Peerly">
  {id && <ProfileClient anonymousIdentityId={id} client:load />}
</StudentLayout>
