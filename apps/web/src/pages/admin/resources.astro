---
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminResourcesClient from '@components/admin/AdminResourcesClient';
import { adminApi } from '@lib/api';

let resourcesData = undefined;
try {
  resourcesData = await adminApi.getResources({ page: 1, limit: 20 });
} catch (e) {
  // Let client load it dynamically in browser
}
---

<AdminLayout
  title="Resource Management | Peerly"
  description="Manage mental health resources for students"
  adminName="Admin"
  currentPage="resources"
>
  <AdminResourcesClient initialData={resourcesData} client:load />
</AdminLayout>