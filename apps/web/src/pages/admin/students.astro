---
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminStudentsClient from '@components/admin/AdminStudentsClient';
import { adminApi } from '@lib/api';

let studentsData = undefined;
try {
  studentsData = await adminApi.getUsers({ page: 1, limit: 20, role: 'STUDENT' });
} catch (e) {
  // Let client load it dynamically in browser
}
---

<AdminLayout
  title="Manage Students | Peerly"
  description="View and manage student accounts"
  adminName="Admin"
  currentPage="students"
>
  <AdminStudentsClient initialData={studentsData} client:load />
</AdminLayout>