---
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminWorkshopsClient from '@components/admin/AdminWorkshopsClient';
import { adminApi } from '@lib/api';

let workshopsData = undefined;
try {
  workshopsData = await adminApi.getWorkshops({ page: 1, limit: 20 });
} catch (e) {
  // Let client load it dynamically in browser
}
---

<AdminLayout
  title="Workshop Management | Peerly"
  description="View and manage all platform workshops"
  adminName="Admin"
  currentPage="workshops"
>
  <AdminWorkshopsClient initialData={workshopsData} client:load />
</AdminLayout>