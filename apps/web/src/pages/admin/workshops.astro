---
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminWorkshopsClient from '@components/admin/AdminWorkshopsClient';
import { adminApi } from '@lib/api';

const workshopsData = await adminApi.getWorkshops({ page: 1, limit: 20 });
---

<AdminLayout
  title="Workshop Management | Campus Anonymous Peer Support"
  description="View and manage all platform workshops"
  adminName="Admin"
  currentPage="workshops"
>
  <AdminWorkshopsClient initialData={workshopsData} client:load />
</AdminLayout>