---
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminDashboardClient from '@components/dashboard/AdminDashboardClient';
import { dashboardApi } from '@lib/api';

let data = undefined;
try {
  data = await dashboardApi.getAdminDashboard();
} catch (e) {
  // Let client load it dynamically in browser
}
---

<AdminLayout
  title="Admin Dashboard | Peerly"
  description="Administrative dashboard for managing the peer support platform"
  adminName="Admin"
  currentPage="dashboard"
>
  <AdminDashboardClient initialData={data} client:load />
</AdminLayout>
