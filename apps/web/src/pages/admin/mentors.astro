---
import AdminLayout from '@layouts/AdminLayout.astro';
import AdminMentorsClient from '@components/admin/AdminMentorsClient';
import { adminApi } from '@lib/api';

let mentorsData = undefined;
try {
  mentorsData = await adminApi.getMentors({ page: 1, limit: 20 });
} catch (e) {
  // Let client load it dynamically in browser
}
---

<AdminLayout
  title="Mentor Management | Peerly"
  description="Manage mentor verification and view mentor details"
  adminName="Admin"
  currentPage="mentors"
>
  <AdminMentorsClient initialData={mentorsData} client:load />
</AdminLayout>