---
import Head from '../components/Head.astro';
import '@/styles/global.css';

const title = "Peerly — Anonymous Peer Support for Students";
const description = "A simple, anonymous peer support platform for first-year students. Connect with verified mentors and access resources.";
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={title} description={description} />
  </head>
  <body class="bg-background-100 text-primary min-h-screen font-sans antialiased flex flex-col justify-between relative overflow-x-hidden">
    <!-- Subtle Premium Motion Background -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden z-0 select-none" aria-hidden="true" id="motion-bg">
      <!-- Shape 1: Circle -->
      <svg class="absolute w-24 h-24 sm:w-32 sm:h-32 transition-opacity duration-1000 opacity-0" id="shape-circle" viewBox="0 0 100 100">
        <circle cx="50" cy="50" r="45" fill="none" stroke="rgba(148, 163, 184, 0.07)" stroke-width="1.2" />
      </svg>
      <!-- Shape 2: Square -->
      <svg class="absolute w-28 h-28 sm:w-36 sm:h-36 transition-opacity duration-1000 opacity-0" id="shape-square" viewBox="0 0 100 100">
        <rect x="5" y="5" width="90" height="90" fill="none" stroke="rgba(201, 106, 43, 0.08)" stroke-width="1.2" />
      </svg>
      <!-- Shape 3: Triangle -->
      <svg class="absolute w-24 h-24 sm:w-32 sm:h-32 transition-opacity duration-1000 opacity-0" id="shape-triangle" viewBox="0 0 100 100">
        <polygon points="50,10 90,85 10,85" fill="none" stroke="rgba(148, 163, 184, 0.07)" stroke-width="1.2" />
      </svg>
      <!-- Shape 4: Hexagon -->
      <svg class="absolute w-28 h-28 sm:w-36 sm:h-36 transition-opacity duration-1000 opacity-0" id="shape-hexagon" viewBox="0 0 100 100">
        <polygon points="50,6 88,28 88,72 50,94 12,72 12,28" fill="none" stroke="rgba(201, 106, 43, 0.08)" stroke-width="1.2" />
      </svg>
      <!-- Connecting lines SVG -->
      <svg class="absolute inset-0 w-full h-full transition-opacity duration-1000 opacity-0" id="shapes-connections">
        <line id="line-1" x1="0" y1="0" x2="0" y2="0" stroke="rgba(148, 163, 184, 0.03)" stroke-width="0.75" stroke-dasharray="4 4" />
        <line id="line-2" x1="0" y1="0" x2="0" y2="0" stroke="rgba(148, 163, 184, 0.03)" stroke-width="0.75" stroke-dasharray="4 4" />
        <line id="line-3" x1="0" y1="0" x2="0" y2="0" stroke="rgba(148, 163, 184, 0.03)" stroke-width="0.75" stroke-dasharray="4 4" />
        <line id="line-4" x1="0" y1="0" x2="0" y2="0" stroke="rgba(148, 163, 184, 0.03)" stroke-width="0.75" stroke-dasharray="4 4" />
      </svg>
    </div>

    <header class="bg-background-100 border-b border-gray-200 relative z-10">
      <div class="mx-auto max-w-4xl px-6">
        <div class="flex h-14 items-center justify-between">
          <div class="flex items-center gap-2">
            <svg
              class="h-5 w-5 text-gray-900"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.109A11.386 11.386 0 0110.089 18M15 12a3.75 3.75 0 100-7.5 3.75 3.75 0 000 7.5zm-6 9c.172 0 .343-.003.514-.01M9 21a9.041 9.041 0 01-6.208-3.07 3.562 3.562 0 013.47-4.43H9m12 0H9m12 0v-1.5m0 1.5v1.5M9 12a3.75 3.75 0 100-7.5 3.75 3.75 0 000 7.5z" />
            </svg>
            <span class="text-heading-16 font-bold tracking-tight text-gray-1000">Peerly</span>
          </div>
          <nav class="flex items-center gap-4">
            <a
              href="/login"
              class="text-xs font-semibold text-gray-600 hover:text-gray-1000 transition-colors">Sign In</a
            >
            <a
              href="/register"
              class="text-xs font-bold text-background-100 bg-primary hover:bg-gray-900 rounded-sm px-3 py-1.5 transition-colors"
              >Get Started</a
            >
          </nav>
        </div>
      </div>
    </header>

    <main class="flex-grow flex flex-col justify-center py-12 md:py-16 relative z-10">
      <div class="mx-auto max-w-2xl px-6 w-full text-center">
        <!-- Hero Section -->
        <h1 class="text-heading-36 sm:text-heading-48 font-bold text-gray-1000 tracking-tight mb-3">
          Peerly
        </h1>
        <p class="text-copy-15 text-gray-600 max-w-md mx-auto mb-8 font-medium leading-relaxed">
          A simple, anonymous peer support platform for first-year students.
        </p>

        <!-- Actions -->
        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 mb-12">
          <a
            href="/register"
            class="w-full sm:w-auto px-5 py-2 bg-primary text-background-100 hover:bg-gray-900 rounded-sm text-xs font-bold transition-colors text-center"
          >
            Create Anonymous Account
          </a>
          <a
            href="/login"
            class="w-full sm:w-auto px-5 py-2 border border-gray-200 text-gray-700 hover:bg-gray-50 rounded-sm text-xs font-semibold transition-colors text-center"
          >
            Sign In
          </a>
        </div>

        <!-- How It Works Section: Minimal Monochrome list -->
        <div class="border-t border-gray-200 pt-10 text-left max-w-lg mx-auto">
          <h2 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-6">How it works</h2>
          <div class="space-y-6">
            <div class="flex gap-4">
              <div class="flex-shrink-0 mt-0.5">
                <svg class="h-4 w-4 text-gray-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 5.25a3 3 0 013 3m3 0a6 6 0 01-7.029 5.912c-.563-.097-1.159.026-1.563.43L10.5 17.25H8.25v2.25H6v2.25H2.25v-2.818c0-.597.237-1.17.659-1.591l6.499-6.499c.404-.404.527-1 .43-1.563A6 6 0 1121.75 8.25z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xs font-bold text-gray-900 mb-1">1. Register Anonymously</h3>
                <p class="text-xs font-semibold text-gray-600 leading-normal">
                  Sign up with your university email. Your email is verified but never stored or visible on the platform.
                </p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="flex-shrink-0 mt-0.5">
                <svg class="h-4 w-4 text-gray-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.982 18.725A7.488 7.488 0 0012 15.75a7.488 7.488 0 00-5.982 2.975m11.963 0a9 9 0 10-11.963 0m11.963 0A8.966 8.966 0 0112 21a8.966 8.966 0 01-5.982-2.275M15 9.75a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xs font-bold text-gray-900 mb-1">2. Receive a Campus Persona</h3>
                <p class="text-xs font-semibold text-gray-600 leading-normal">
                  You are assigned a persistent random name for chats, posts, and group meetings.
                </p>
              </div>
            </div>

            <div class="flex gap-4">
              <div class="flex-shrink-0 mt-0.5">
                <svg class="h-4 w-4 text-gray-900" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379L12 21l3.12-3.136c1.152-.086 2.293-.213 3.423-.379 1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0012 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018z" />
                </svg>
              </div>
              <div>
                <h3 class="text-xs font-bold text-gray-900 mb-1">3. Talk & Get Support</h3>
                <p class="text-xs font-semibold text-gray-600 leading-normal">
                  Discuss anonymously, talk to verified mentors, attend online workshops, and access local mental health resources.
                </p>
              </div>
            </div>
          </div>
        </div>

      </div>
    </main>

    <footer class="bg-background-100 border-t border-gray-200 py-6 relative z-10">
      <div class="mx-auto max-w-4xl px-6">
        <div class="flex flex-col md:flex-row items-center justify-between gap-4">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-gray-900">Peerly</span>
            <span class="text-[11px] text-gray-400">|</span>
            <span class="text-[11px] font-semibold text-gray-500">Confidential & Safe Space</span>
          </div>
          <div class="flex items-center gap-4 text-xs font-semibold text-gray-500">
            <a href="/privacy" class="hover:text-gray-900 transition-colors">Privacy</a>
            <a href="/terms" class="hover:text-gray-900 transition-colors">Terms</a>
            <a href="/safety" class="hover:text-gray-900 transition-colors">Safety</a>
          </div>
        </div>
        <div class="mt-4 flex flex-col md:flex-row items-center justify-between gap-2 border-t border-gray-100 pt-4">
          <p class="text-[11px] font-medium text-gray-400">
            &copy; 2026 Peerly. Strictly anonymous support for students.
          </p>
        </div>
      </div>
    </footer>

    <script>
      // Subtle Premium Motion Background script
      document.addEventListener('DOMContentLoaded', () => {
        const bgContainer = document.getElementById('motion-bg');
        if (!bgContainer) return;

        const shapes = [
          {
            id: 'shape-circle',
            vw: 0.15,
            vh: 0.22,
            speedX: 0.00004,
            speedY: 0.00003,
            speedR: 0.00002,
            ampX: 30,
            ampY: 20,
            ampR: 2.0,
            parallax: 0.4,
            size: 112,
          },
          {
            id: 'shape-square',
            vw: 0.82,
            vh: 0.18,
            speedX: 0.00003,
            speedY: 0.00004,
            speedR: 0.00003,
            ampX: 25,
            ampY: 25,
            ampR: 2.5,
            parallax: 0.7,
            size: 128,
          },
          {
            id: 'shape-triangle',
            vw: 0.18,
            vh: 0.72,
            speedX: 0.00004,
            speedY: 0.00004,
            speedR: 0.00003,
            ampX: 28,
            ampY: 22,
            ampR: 1.8,
            parallax: 0.5,
            size: 112,
          },
          {
            id: 'shape-hexagon',
            vw: 0.80,
            vh: 0.68,
            speedX: 0.00002,
            speedY: 0.00003,
            speedR: 0.00002,
            ampX: 22,
            ampY: 30,
            ampR: 1.5,
            parallax: 0.9,
            size: 128,
          }
        ];

        let width = window.innerWidth;
        let height = window.innerHeight;
        
        let targetMouseX = 0;
        let targetMouseY = 0;
        let currentMouseX = 0;
        let currentMouseY = 0;

        const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        // Position shapes initially and fade in
        shapes.forEach(shape => {
          const el = document.getElementById(shape.id);
          if (el) {
            setTimeout(() => {
              el.classList.remove('opacity-0');
            }, 100);
          }
        });

        const linesEl = document.getElementById('shapes-connections');
        if (linesEl) {
          setTimeout(() => {
            linesEl.classList.remove('opacity-0');
          }, 300);
        }

        // Handle window resizing
        window.addEventListener('resize', () => {
          width = window.innerWidth;
          height = window.innerHeight;
          if (prefersReduced) {
            updatePositions(0);
          }
        });

        if (prefersReduced) {
          // Render statically without parallax or animation
          updatePositions(0);
          return;
        }

        // Mouse movement triggers parallax
        window.addEventListener('mousemove', (e) => {
          targetMouseX = (e.clientX / width) - 0.5;
          targetMouseY = (e.clientY / height) - 0.5;
        });

        function updatePositions(time: number) {
          // Slow interpolation for smooth lag/parallax effect
          currentMouseX += (targetMouseX - currentMouseX) * 0.04;
          currentMouseY += (targetMouseY - currentMouseY) * 0.04;

          const coords = shapes.map(shape => {
            const el = document.getElementById(shape.id);
            if (!el) return null;

            // Responsive scale down on small screens
            const scale = width < 640 ? 0.7 : 1.0;
            const size = shape.size * scale;

            const baseX = width * shape.vw - (size / 2);
            const baseY = height * shape.vh - (size / 2);

            // Floating movement using slow sine waves
            const floatX = Math.sin(time * shape.speedX) * shape.ampX;
            const floatY = Math.cos(time * shape.speedY) * shape.ampY;
            const rotate = Math.sin(time * shape.speedR) * shape.ampR;

            // Mouse parallax movement
            const pX = currentMouseX * shape.parallax * 60;
            const pY = currentMouseY * shape.parallax * 60;

            const totalX = baseX + floatX + pX;
            const totalY = baseY + floatY + pY;

            // Apply 3D translate and rotate
            el.style.transform = `translate3d(${totalX}px, ${totalY}px, 0) rotate(${rotate}deg)`;

            return {
              x: totalX + (size / 2),
              y: totalY + (size / 2)
            };
          });

          // Draw the dotted connecting lines between centers
          const connections = [
            { from: 0, to: 1, lineId: 'line-1' },
            { from: 1, to: 3, lineId: 'line-2' },
            { from: 3, to: 2, lineId: 'line-3' },
            { from: 2, to: 0, lineId: 'line-4' }
          ];

          connections.forEach(conn => {
            const fromCoord = coords[conn.from];
            const toCoord = coords[conn.to];
            const line = document.getElementById(conn.lineId);

            if (fromCoord && toCoord && line) {
              line.setAttribute('x1', String(fromCoord.x));
              line.setAttribute('y1', String(fromCoord.y));
              line.setAttribute('x2', String(toCoord.x));
              line.setAttribute('y2', String(toCoord.y));
            }
          });
        }

        // Animation loop
        let animationFrameId: number;
        function loop(time: number) {
          updatePositions(time);
          animationFrameId = requestAnimationFrame(loop);
        }

        requestAnimationFrame(loop);
      });
    </script>
  </body>
</html>
