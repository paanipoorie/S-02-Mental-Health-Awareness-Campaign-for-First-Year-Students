---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/landing/Hero.astro';
import HowItWorks from '../components/landing/HowItWorks.astro';
import MattersSection from '../components/landing/MattersSection.astro';
import FeatureGrid from '../components/landing/FeatureGrid.astro';
import PrivacySection from '../components/landing/PrivacySection.astro';
import FAQSection from '../components/landing/FAQSection.astro';
import Footer from '../components/landing/Footer.astro';

const title = 'Peerly — Anonymous Peer Support for Students';
const description =
  'A safe, confidential anonymous peer support platform for first-year students. Connect with verified mentors, join group discussions, and access local wellness resources.';
---

<BaseLayout title={title} description={description} isFullWidth={true}>
  <Hero />
  <HowItWorks />
  <MattersSection />
  <FeatureGrid />
  <PrivacySection />
  <FAQSection />
  <Footer />
</BaseLayout>
